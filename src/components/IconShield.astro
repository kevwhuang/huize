---
interface Props {
    size?: number;
    strokeWidth?: number;
}

const { size = 20, strokeWidth = 2 } = Astro.props;
---

<svg
    aria-hidden="true"
    fill="none"
    height={size}
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width={strokeWidth}
    viewBox="0 0 24 24"
    width={size}
>
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
</svg>
