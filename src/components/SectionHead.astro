---
import { getEditId } from '@lib/database';

interface Props {
    editKey?: string;
    eyebrow: string;
    headingId: string;
    isCentered?: boolean;
    isOnDark?: boolean;
}

const { editKey, eyebrow, headingId, isCentered = false, isOnDark = false } = Astro.props;
---

<header
    class:list={['section-head', { 'section-head--center': isCentered }]}
    data-scroll
>
    <p
        class:list={['eyebrow', { 'eyebrow--center': isCentered, 'eyebrow--on-dark': isOnDark }]}
        lang="en"
    >
        {eyebrow}
    </p>
    <h2
        id={headingId}
        data-edit={editKey}
        data-edit-id={editKey && getEditId(editKey)}
    >
        <slot />
    </h2>
    <slot name="text" />
</header>

<style>
    .eyebrow--center::after {
        background: currentColor;
        content: '';
        height: 0.125rem;
        width: 1.875rem;
    }

    .section-head--center {
        margin-inline: auto;
        text-align: center;
    }
</style>
