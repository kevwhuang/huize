---
interface Props {
    size?: number;
    strokeWidth?: number;
}

const { size = 20, strokeWidth = 2 } = Astro.props;
---

<svg
    aria-hidden="true"
    fill="none"
    height={size}
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width={strokeWidth}
    viewBox="0 0 24 24"
    width={size}
>
    <path d="m9 18 6-6-6-6" />
</svg>
