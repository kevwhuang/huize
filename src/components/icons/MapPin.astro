---
interface Props {
    size?: number;
    strokeWidth?: number;
}

const { size = 20, strokeWidth = 2 } = Astro.props;
---

<svg
    aria-hidden="true"
    fill="none"
    height={size}
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width={strokeWidth}
    viewBox="0 0 24 24"
    width={size}
>
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
    <circle cx="12" cy="10" r="3" />
</svg>
