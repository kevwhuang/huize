---

---

<section
    aria-labelledby="error-server-title"
    class="errorserver"
>
    <h1
        id="error-server-title"
        class="errorserver__code"
    >500
    </h1>
    <p class="errorserver__text">服务器出现错误，请稍后再试</p>
    <a class="errorserver__link" href="/">返回首页</a>
</section>

<style>
    .errorserver {
        align-items: center;
        display: grid;
        justify-items: center;
        min-height: 60vh;
        padding: 80px 20px;
    }

    .errorserver__code {
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: clamp(4rem, 10vw, 8rem);
        font-weight: 700;
        margin-bottom: 16px;
    }

    .errorserver__text {
        color: var(--color-sage);
        font-size: 18px;
        margin-bottom: 32px;
    }

    .errorserver__link {
        background: var(--color-jade);
        border-radius: 12px;
        color: #ffffff;
        font-size: 15.5px;
        font-weight: 500;
        padding: 15px 30px;
        transition: background var(--duration-fast), transform var(--duration-fast);
    }

    .errorserver__link:hover {
        background: var(--color-jade-deep);
        transform: translateY(-2px);
    }

    .errorserver__link:active {
        transform: translateY(0);
    }
</style>
