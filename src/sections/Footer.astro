---
import IconDouyin from '@components/IconDouyin.astro';
import IconShield from '@components/IconShield.astro';
import IconWechat from '@components/IconWechat.astro';
import IconWeibo from '@components/IconWeibo.astro';
import IconXiaohongshu from '@components/IconXiaohongshu.astro';
import QrCode from '@components/QrCode.astro';
import logoIcon from '@images/logo_icon.webp';
import { LINKS, ROUTES } from '@lib/constants';

const FOOTER_ROUTES = ROUTES.filter(route => route.path !== '/');

const SOCIALS = [
    { Icon: IconWechat, href: LINKS.wechat, label: '微信公众号' },
    { Icon: IconWeibo, label: '新浪微博' },
    { Icon: IconDouyin, label: '抖音' },
    { Icon: IconXiaohongshu, label: '小红书' },
];
---

<footer class="footer">
    <div class="footer__inner shell">
        <div class="footer__grid">
            <div class="footer__brand-col">
                <a
                    class="footer__logo"
                    href="/"
                >
                    <span class="footer__logo-icon">
                        <img
                            alt=""
                            height={30}
                            src={logoIcon.src}
                            width={30}
                        />
                    </span>
                    <span class="footer__logo-text">
                        <span class="footer__logo-zh">惠泽健康</span>
                        <span
                            class="footer__logo-en"
                            lang="en"
                        >
                            Huize Health
                        </span>
                    </span>
                </a>
                <p class="footer__desc">数字健康科技平台，提供全流程、一站式的养老服务和健康管理服务。</p>
                <ul class="footer__socials">
                    {SOCIALS.map(({ Icon, href, label }) => (
                        <li>
                            <a
                                class="footer__social"
                                aria-disabled={href ? undefined : 'true'}
                                aria-label={href ? label : `${label}（敬请期待）`}
                                href={href ?? '#'}
                                rel={href ? 'noopener noreferrer' : undefined}
                                tabindex={href ? undefined : '-1'}
                                target={href ? '_blank' : undefined}
                            >
                                <Icon size={17} />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            {FOOTER_ROUTES.map(route => (
                <nav
                    class="footer__col"
                    aria-label={route.label}
                >
                    <h2 class="footer__heading">{route.label}</h2>
                    <ul class="footer__links">
                        {(route.children ?? [route]).map(child => (
                            <li>
                                <a
                                    class="footer__link"
                                    href={child.path}
                                >
                                    {child.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))}

            <div class="footer__qr-col">
                <h2 class="footer__heading">关注公众号</h2>
                <a
                    class="footer__qr"
                    aria-label="关注惠泽健康微信公众号"
                    href={LINKS.wechat}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <QrCode size={102} />
                </a>
                <p class="footer__qr-label">扫码关注 &middot; 惠泽康护</p>
            </div>
        </div>

        <div class="footer__contact">
            <a
                class="footer__contact-link"
                href={LINKS.hotlineHref}
            >
                全国服务热线 {LINKS.hotline}
            </a>
            <a
                class="footer__contact-link"
                href={LINKS.shanghaiHref}
            >
                上海总部 {LINKS.shanghai}
            </a>
            <span>{LINKS.address}</span>
        </div>

        <div class="footer__legal">
            <span>Copyright 2019&ndash;2026 {LINKS.company}</span>
            <a
                href={LINKS.icpHref}
                rel="noopener noreferrer"
                target="_blank"
            >
                {LINKS.icp}
            </a>
            <a
                class="footer__legal-badge"
                href={LINKS.policeHref}
                rel="noopener noreferrer"
                target="_blank"
            >
                <IconShield size={13} />
                {LINKS.police}
            </a>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: var(--color-forest);
        color: var(--color-white-70);
    }

    .footer__brand-col {
        min-width: 12.5rem;
        padding-right: clamp(0rem, calc(-0.83rem + 4.17vw), 2.25rem);
    }

    .footer__col {
        min-width: 0;
    }

    .footer__contact {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-12);
        display: flex;
        flex-wrap: wrap;
        font-size: 0.84rem;
        gap: 0.5rem 1.625rem;
        justify-content: space-between;
        margin-top: 3rem;
        padding-block: 1.625rem;
    }

    .footer__contact-link {
        color: var(--color-white-92);
        position: relative;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    }

    .footer__contact-link:active {
        opacity: 0.8;
    }

    .footer__contact-link:hover {
        color: var(--color-reef);
    }

    .footer__contact-link::after {
        content: '';
        inset: -0.75rem -0.5rem;
        position: absolute;
    }

    .footer__desc {
        color: var(--color-white-70);
        font-size: 0.84rem;
        line-height: 1.9;
        margin-bottom: 0;
        margin-top: 1.25rem;
        max-width: 16.25rem;
    }

    .footer__grid {
        display: grid;
        gap: 2.875rem;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }

    .footer__heading {
        color: #FFFFFF;
        font-size: 0.97rem;
        letter-spacing: 0.06em;
        margin-bottom: 1.125rem;
    }

    .footer__inner {
        padding-top: clamp(3.5rem, calc(2.67rem + 4.17vw), 5.25rem);
    }

    .footer__legal {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-08);
        color: var(--color-white-55);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-label);
        font-size: 0.75rem;
        gap: 0.375rem 1.375rem;
        letter-spacing: 0.03em;
        padding: 1.25rem 0 1.875rem;
    }

    .footer__legal a {
        color: var(--color-white-55);
        position: relative;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    }

    .footer__legal a:active {
        opacity: 0.8;
    }

    .footer__legal a:hover {
        color: #FFFFFF;
    }

    .footer__legal a::after {
        content: '';
        inset: -0.8125rem -0.3125rem;
        position: absolute;
    }

    .footer__legal-badge {
        align-items: center;
        display: inline-flex;
        gap: 0.375rem;
    }

    .footer__link {
        color: var(--color-white-70);
        display: block;
        font-size: 0.875rem;
        padding-block: 0.5rem;
        position: relative;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    }

    .footer__link:active {
        opacity: 0.8;
    }

    .footer__link:hover {
        color: #FFFFFF;
    }

    .footer__link::after {
        content: '';
        inset: 0 -0.75rem;
        position: absolute;
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .footer__logo {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .footer__logo:active {
        opacity: 0.8;
    }

    .footer__logo:hover .footer__logo-zh {
        color: var(--color-reef);
    }

    .footer__logo-en {
        color: var(--color-white-55);
        font-family: var(--font-label);
        font-size: 0.5625rem;
        letter-spacing: 0.28em;
        margin-top: 0.25rem;
        text-transform: uppercase;
    }

    .footer__logo-icon {
        align-items: center;
        background: #FFFFFF;
        border-radius: var(--radius-card-sm);
        display: flex;
        height: 2.5rem;
        justify-content: center;
        width: 2.5rem;
    }

    .footer__logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

    .footer__logo-zh {
        color: #FFFFFF;
        font-family: var(--font-display);
        font-size: 1.1875rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .footer__qr {
        background: #FFFFFF;
        border-radius: var(--radius-card-sm);
        color: var(--color-pine);
        display: block;
        line-height: 0;
        padding: 0.5rem;
        transition: transform var(--duration-fast) var(--ease-out);
        width: fit-content;
    }

    .footer__qr:active {
        transform: translateY(0);
    }

    .footer__qr:hover {
        transform: translateY(-0.125rem);
    }

    .footer__qr-col {
        min-width: 9.375rem;
    }

    .footer__qr-label {
        color: var(--color-white-55);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
        margin-bottom: 0;
        margin-top: 0.875rem;
    }

    .footer__social {
        align-items: center;
        border: 0.0625rem solid var(--color-white-12);
        border-radius: 50%;
        color: var(--color-white-92);
        display: flex;
        height: 2.75rem;
        justify-content: center;
        transition:
            background var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
        width: 2.75rem;
    }

    .footer__social:active {
        background: var(--color-jade-deep);
    }

    .footer__social:hover {
        background: var(--color-jade);
        border-color: var(--color-jade);
        color: #FFFFFF;
    }

    .footer__social[aria-disabled='true'] {
        color: var(--color-white-55);
        cursor: not-allowed;
        opacity: 0.55;
    }

    .footer__social[aria-disabled='true']:active,
    .footer__social[aria-disabled='true']:hover {
        background: transparent;
        border-color: var(--color-white-12);
        color: var(--color-white-55);
    }

    .footer__socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        list-style: none;
        margin-top: 1.375rem;
        padding: 0;
    }
</style>

<script>
    import { initInertControls, registerPageScript } from '@lib/utils';

    function initFooter(signal: AbortSignal) {
        initInertControls('.footer a[aria-disabled="true"]', signal);
    }

    registerPageScript(initFooter);
</script>
