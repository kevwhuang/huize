---
import IconGlobe from '@components/IconGlobe.astro';
import IconMapPin from '@components/IconMapPin.astro';
import IconPhone from '@components/IconPhone.astro';
import QrCode from '@components/QrCode.astro';
import { LINKS } from '@lib/constants';

const SERVICE_TYPES = ['康养服务', '健康管理', '保险服务', '高端定制', '其他'];
---

<section
    id="contact"
    class="contact-panel section"
    aria-labelledby="contact-panel-title"
>
    <div class="shell">
        <div class="contact-panel__grid">
            <div data-scroll="left">
                <h2
                    id="contact-panel-title"
                    class="sr-only"
                >
                    咨询表单
                </h2>
                <form
                    class="contact-panel__form card"
                    novalidate
                >
                    <div class="contact-panel__row">
                        <label class="contact-panel__field">
                            <span>
                                姓名
                                <span
                                    class="contact-panel__required"
                                    aria-hidden="true"
                                >*
                                </span>
                            </span>
                            <input
                                autocomplete="name"
                                name="name"
                                placeholder="请输入您的姓名"
                                required
                                type="text"
                            />
                        </label>
                        <label class="contact-panel__field">
                            <span>
                                电话
                                <span
                                    class="contact-panel__required"
                                    aria-hidden="true"
                                >*
                                </span>
                            </span>
                            <input
                                autocomplete="tel"
                                inputmode="tel"
                                name="phone"
                                pattern="[0-9\-\s+]{6,}"
                                placeholder="请输入您的联系电话"
                                required
                                type="tel"
                            />
                        </label>
                    </div>
                    <label class="contact-panel__field">
                        <span>服务类型</span>
                        <select name="type">
                            <option value="">请选择服务类型</option>
                            {SERVICE_TYPES.map(type => (
                                <option value={type}>{type}</option>
                            ))}
                        </select>
                    </label>
                    <label class="contact-panel__field">
                        <span>留言</span>
                        <textarea
                            name="message"
                            placeholder="请描述您的具体需求"
                            rows="4"
                        />
                    </label>
                    <button
                        class="button button--large button--primary"
                        aria-describedby="contact-panel-note"
                        disabled
                        type="submit"
                    >
                        立即咨询
                    </button>
                    <p
                        id="contact-panel-note"
                        class="contact-panel__note"
                    >
                        在线提交暂未开放，请致电全国服务热线
                        <a href={LINKS.hotlineHref}>{LINKS.hotline}</a>
                        与专属健康顾问联系。
                    </p>
                </form>
            </div>

            <div
                class="contact-panel__aside"
                data-scroll="right"
            >
                <h2>联系方式</h2>
                <p class="contact-panel__lead">无论是养老照护还是医疗咨询，惠泽都在您身边。</p>
                <dl class="contact-panel__details">
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <IconPhone size={19} />
                            </span>
                            全国服务热线
                        </dt>
                        <dd><a href={LINKS.hotlineHref}>{LINKS.hotline}</a></dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <IconPhone size={19} />
                            </span>
                            上海总部
                        </dt>
                        <dd><a href={LINKS.shanghaiHref}>{LINKS.shanghai}</a></dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <IconMapPin size={19} />
                            </span>
                            公司地址
                        </dt>
                        <dd>{LINKS.address}</dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <IconGlobe size={19} />
                            </span>
                            公司网址
                        </dt>
                        <dd>{LINKS.website}</dd>
                    </div>
                </dl>
                <div class="contact-panel__qr">
                    <a
                        class="contact-panel__qr-frame"
                        aria-label="关注惠泽健康微信公众号"
                        href={LINKS.wechat}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        <QrCode size={96} />
                    </a>
                    <p>扫码关注公众号<br />惠泽康护</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-panel__aside {
        --heading-color: #FFFFFF;
        background: var(--color-pine);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-panel);
        color: var(--color-white-70);
        padding: clamp(1.75rem, calc(1.42rem + 1.67vw), 2.5rem);
    }

    .contact-panel__aside h2 {
        font-size: var(--text-h3);
    }

    .contact-panel__detail {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        justify-content: space-between;
    }

    .contact-panel__detail a {
        color: #FFFFFF;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .contact-panel__detail a:active {
        opacity: 0.8;
    }

    .contact-panel__detail a:hover {
        color: var(--color-reef);
    }

    .contact-panel__details {
        display: grid;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .contact-panel__details dd {
        color: var(--color-white-92);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 0;
        text-align: right;
    }

    .contact-panel__details dt {
        align-items: center;
        display: flex;
        gap: 0.625rem;
        margin-bottom: 0;
    }

    .contact-panel__field {
        display: grid;
        gap: 0.5rem;
    }

    .contact-panel__field > span {
        color: var(--color-sage-dark);
        font-size: 0.84rem;
        font-weight: 500;
    }

    .contact-panel__field :is(input, select, textarea) {
        background: var(--color-dew);
        border: 0.0625rem solid var(--color-stone);
        border-radius: var(--radius-card-sm);
        color: var(--color-cedar);
        font: inherit;
        padding: 0.875rem 1rem;
        transition:
            background var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            box-shadow var(--duration-fast) var(--ease-out);
        width: 100%;
    }

    .contact-panel__field :is(input, select, textarea):focus-visible {
        background: #FFFFFF;
        border-color: var(--color-jade);
        box-shadow: 0 0 0 0.1875rem var(--color-jade-20);
        outline: none;
    }

    .contact-panel__field :is(input, select, textarea):hover {
        border-color: var(--color-sand);
    }

    .contact-panel__field textarea {
        resize: vertical;
    }

    .contact-panel__form {
        display: grid;
        gap: 1.125rem;
    }

    .contact-panel__grid {
        align-items: start;
        display: grid;
        gap: clamp(2rem, calc(1.33rem + 3.33vw), 3.5rem);
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    .contact-panel__lead {
        color: var(--color-white-70);
        font-size: 0.9rem;
        font-weight: 400;
        line-height: 1.8;
        margin-bottom: 2.125rem;
    }

    .contact-panel__note {
        color: var(--color-sage);
        font-size: 0.84rem;
        margin-bottom: 0;
        text-align: center;
    }

    .contact-panel__note a {
        color: var(--color-jade);
        font-weight: 500;
    }

    .contact-panel__note a:active {
        opacity: 0.8;
    }

    .contact-panel__note a:hover {
        text-decoration: underline;
    }

    .contact-panel__qr {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-12);
        color: var(--color-white-70);
        display: flex;
        font-size: 0.8125rem;
        gap: 1rem;
        padding-top: 1.75rem;
    }

    .contact-panel__qr p {
        margin-bottom: 0;
    }

    .contact-panel__qr-frame {
        background: #FFFFFF;
        border-radius: var(--radius-card-sm);
        color: var(--color-pine);
        display: block;
        flex-shrink: 0;
        line-height: 0;
        padding: 0.5rem;
        transition: transform var(--duration-fast) var(--ease-out);
    }

    .contact-panel__qr-frame:active {
        transform: translateY(0);
    }

    .contact-panel__qr-frame:hover {
        transform: translateY(-0.125rem);
    }

    .contact-panel__required {
        color: var(--color-coral);
    }

    .contact-panel__row {
        display: grid;
        gap: 1.125rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 1024px) {
        .contact-panel__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .contact-panel__row {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/utils';

    function initContactPanel(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.contact-panel__form');

        form?.addEventListener('submit', event => event.preventDefault(), { signal });
    }

    registerPageScript(initContactPanel);
</script>
