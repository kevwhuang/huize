---
import SectionHead from '@components/SectionHead.astro';
import { getEditId, getSection } from '@lib/database';

const milestones = await getSection('about-milestones');

const figures = milestones.groups?.milestones ?? [];
const [start] = milestones.groups?.start ?? [];
---

<section
    class="about-milestones section section--dark"
    aria-labelledby="about-milestones-title"
>
    <div class="about-milestones__grid shell">
        <div data-scroll="left">
            <SectionHead
                editKey="sections/about-milestones.heading"
                eyebrow={milestones.eyebrow ?? ''}
                headingId="about-milestones-title"
                isOnDark
            >
                {milestones.heading}
                <Fragment slot="text">
                    <p
                        data-edit="sections/about-milestones.lead"
                        data-edit-id={getEditId('sections/about-milestones.lead')}
                    >
                        {milestones.lead}
                    </p>
                </Fragment>
            </SectionHead>
        </div>
        <dl
            class="about-milestones__stats"
            data-scroll="scale"
            data-scroll-stagger
        >
            <div class="about-milestones__stat">
                <dt class="about-milestones__label">{start.label}</dt>
                <dd class="about-milestones__value">
                    {start.value}<span class="about-milestones__unit">{start.suffix}</span>
                </dd>
            </div>
            {figures.map(figure => (
                <div class="about-milestones__stat">
                    <dt class="about-milestones__label">{figure.label}</dt>
                    <dd
                        class="about-milestones__value"
                        data-count-to={figure.value}
                        data-suffix={figure.suffix}
                    >
                        {figure.value}{figure.suffix}
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .about-milestones__grid {
        align-items: center;
        display: grid;
        gap: var(--space-split);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }

    .about-milestones__label {
        color: var(--color-white-70);
        font-size: var(--text-meta);
        letter-spacing: 0.04em;
        line-height: 1.5;
    }

    .about-milestones__stat {
        border-top: 0.0625rem solid var(--color-white-15);
        display: flex;
        flex-direction: column-reverse;
        gap: 0.5rem;
        padding-top: 1.125rem;
    }

    .about-milestones__stats {
        display: grid;
        gap: var(--space-grid);
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .about-milestones__unit {
        font-size: 0.5em;
        letter-spacing: 0.06em;
    }

    .about-milestones__value {
        align-items: baseline;
        color: var(--color-gold-light);
        display: flex;
        font-family: var(--font-display);
        font-size: clamp(1.6rem, calc(1.3rem + 1.5vw), 2.5rem);
        font-weight: 700;
        gap: 0.125em;
        line-height: 1.1;
        margin-bottom: 0;
        white-space: nowrap;
    }

    @media (max-width: 1024px) {
        .about-milestones__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .about-milestones__stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .about-milestones__stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
