---
import SectionHead from '@components/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { getEditId, getSection } from '@lib/database';

const FACT_FIELDS = ['company', 'address', 'website'] as const;

const story = await getSection('about-story');

const [demand, supply] = story.groups?.sides ?? [];
const facts = (story.groups?.facts ?? []).map((fact, index) => ({ field: FACT_FIELDS[index], label: fact.label }));
const headingLines = (story.heading ?? '').split('\n');
---

<section
    class="about-story section"
    aria-labelledby="about-story-title"
>
    <div class="about-story__grid shell">
        <div data-scroll="left">
            <SectionHead
                editKey="sections/about-story.heading"
                eyebrow={story.eyebrow ?? ''}
                headingId="about-story-title"
            >
                {headingLines.map((line, index) => (index > 0 ? <Fragment><br />{line}</Fragment> : line))}
            </SectionHead>
            <p
                class="about-story__text"
                data-edit="sections/about-story.lead"
                data-edit-id={getEditId('sections/about-story.lead')}
            >
                {story.lead}
            </p>
            <dl class="about-story__facts">
                {facts.map(fact => (
                    <div class="about-story__fact">
                        <dt>{fact.label}</dt>
                        <dd>{LINKS[fact.field]}</dd>
                    </div>
                ))}
            </dl>
        </div>
        <div data-scroll="right">
            <div class="about-story__panel">
                <div>
                    <h3 class="about-story__side">
                        <span>{demand.label}</span>
                        <span
                            class="label label--on-dark"
                            aria-hidden="true"
                            lang="en"
                        >
                            {demand.english}
                        </span>
                    </h3>
                    <ul class="about-story__chips">
                        {(demand.tags ?? []).map((item, index) => (
                            <li
                                data-edit={`sections/about-story.groups.sides.0.tags.${index}`}
                                data-edit-id={getEditId(`sections/about-story.groups.sides.0.tags.${index}`)}
                            >
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
                <p
                    class="about-story__hub"
                    data-edit="sections/about-story.badge"
                    data-edit-id={getEditId('sections/about-story.badge')}
                >
                    {story.badge}
                </p>
                <div>
                    <h3 class="about-story__side">
                        <span>{supply.label}</span>
                        <span
                            class="label label--on-dark"
                            aria-hidden="true"
                            lang="en"
                        >
                            {supply.english}
                        </span>
                    </h3>
                    <ul class="about-story__chips">
                        {(supply.tags ?? []).map((item, index) => (
                            <li
                                data-edit={`sections/about-story.groups.sides.1.tags.${index}`}
                                data-edit-id={getEditId(`sections/about-story.groups.sides.1.tags.${index}`)}
                            >
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about-story__chips {
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .about-story__chips li {
        background: var(--color-white-10);
        border: 0.0625rem solid var(--color-white-15);
        border-radius: var(--radius-card-sm);
        color: var(--color-white);
        font-size: 0.875rem;
        padding: 0.875rem 0.5rem;
        text-align: center;
    }

    .about-story__fact dd {
        color: var(--color-pine);
        font-size: var(--text-small);
        line-height: 1.7;
        margin-bottom: 0;
    }

    .about-story__fact dt {
        color: var(--color-sage);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        margin-bottom: 0.375rem;
    }

    .about-story__facts {
        border-top: var(--border-soft);
        display: grid;
        gap: 1.125rem;
        padding-top: 1.75rem;
    }

    .about-story__grid {
        align-items: center;
        display: grid;
        gap: var(--space-split);
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .about-story__hub {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        color: var(--color-white);
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        margin-bottom: 0;
        margin-inline: auto;
        padding: 0.625rem 1.5rem;
        position: relative;
        width: fit-content;
    }

    .about-story__hub::after,
    .about-story__hub::before {
        background: var(--color-white-15);
        content: '';
        height: 1.5rem;
        left: 50%;
        position: absolute;
        width: 0.0625rem;
    }

    .about-story__hub::after {
        top: 100%;
    }

    .about-story__hub::before {
        bottom: 100%;
    }

    .about-story__panel {
        background: linear-gradient(160deg, var(--color-pine), var(--color-forest));
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-panel);
        display: grid;
        gap: 1.5rem;
        padding: var(--pad-panel);
    }

    .about-story__side {
        align-items: baseline;
        color: var(--color-white);
        display: flex;
        flex-wrap: wrap;
        font-size: 1rem;
        gap: 0.625rem;
        margin-bottom: 0.875rem;
    }

    .about-story__text {
        color: var(--color-sage);
        line-height: 2;
        margin-bottom: 2rem;
    }

    @media (max-width: 1024px) {
        .about-story__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
