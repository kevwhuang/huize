---
import { getEditId, getSection } from '@lib/database';

const culture = await getSection('about-culture');

const creed = culture.groups?.creed ?? [];
const [values] = culture.groups?.values ?? [];
---

<section
    class="about-culture section"
    aria-labelledby="about-culture-title"
>
    <div class="shell">
        <h2
            id="about-culture-title"
            class="sr-only"
        >
            {culture.heading}
        </h2>
        <ol class="about-culture__creed">
            {creed.map((entry, index) => (
                <li
                    class="about-culture__entry"
                    data-scroll={index === 0 ? 'left' : 'right'}
                >
                    <p
                        class="about-culture__number numeral"
                        aria-hidden="true"
                        data-edit={`sections/about-culture.groups.creed.${index}.number`}
                        data-edit-id={getEditId(`sections/about-culture.groups.creed.${index}.number`)}
                    >
                        {entry.number}
                    </p>
                    <h3 class="about-culture__label">
                        <span>{entry.label}</span>
                        <span
                            class="label label--gold"
                            aria-hidden="true"
                            lang="en"
                        >
                            {entry.english}
                        </span>
                    </h3>
                    <p
                        class="about-culture__statement"
                        data-edit={`sections/about-culture.groups.creed.${index}.text`}
                        data-edit-id={getEditId(`sections/about-culture.groups.creed.${index}.text`)}
                    >
                        {entry.text}
                    </p>
                </li>
            ))}
            <li
                class="about-culture__entry about-culture__entry--values"
                data-scroll="up"
            >
                <p
                    class="about-culture__number numeral"
                    aria-hidden="true"
                    data-edit="sections/about-culture.groups.values.0.number"
                    data-edit-id={getEditId('sections/about-culture.groups.values.0.number')}
                >
                    {values.number}
                </p>
                <h3 class="about-culture__label">
                    <span>{values.label}</span>
                    <span
                        class="label label--gold"
                        aria-hidden="true"
                        lang="en"
                    >
                        {values.english}
                    </span>
                </h3>
                <ul
                    class="about-culture__values"
                    data-scroll="scale"
                    data-scroll-stagger
                >
                    {(culture.tags ?? []).map((value, index) => (
                        <li
                            class="about-culture__value"
                            data-edit={`sections/about-culture.tags.${index}`}
                            data-edit-id={getEditId(`sections/about-culture.tags.${index}`)}
                        >
                            {value}
                        </li>
                    ))}
                </ul>
            </li>
        </ol>
    </div>
</section>

<style>
    .about-culture {
        --pad-block: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
    }

    .about-culture__creed {
        display: grid;
        gap: clamp(3rem, calc(2.33rem + 3.33vw), 5rem);
        list-style: none;
        padding: 0;
    }

    .about-culture__entry {
        border-top: 0.125rem solid var(--color-laurel);
        max-width: var(--measure-prose);
        padding-top: var(--pad-block);
    }

    .about-culture__entry:nth-child(2) {
        margin-left: auto;
        text-align: right;
    }

    .about-culture__entry:nth-child(2) .about-culture__label {
        justify-content: flex-end;
    }

    .about-culture__entry--values {
        margin-inline: auto;
        width: 100%;
    }

    .about-culture__label {
        align-items: baseline;
        color: var(--color-jade);
        display: flex;
        flex-wrap: wrap;
        font-size: var(--text-h3);
        gap: 0.875rem;
        margin-bottom: 0.875rem;
    }

    .about-culture__number {
        margin-bottom: 0.75rem;
    }

    .about-culture__statement {
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: clamp(1.75rem, calc(1.33rem + 2.08vw), 3rem);
        font-weight: 700;
        letter-spacing: 0.03em;
        line-height: 1.35;
        margin-bottom: 0;
        text-wrap: balance;
    }

    .about-culture__value {
        background: var(--color-mint);
        border-radius: var(--radius-card);
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: clamp(1.25rem, calc(1.08rem + 0.83vw), 1.75rem);
        font-weight: 700;
        letter-spacing: 0.16em;
        padding: var(--pad-block) 0.75rem;
        text-align: center;
    }

    .about-culture__values {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
        list-style: none;
        padding: 0;
    }

    @media (max-width: 768px) {
        .about-culture__entry:nth-child(2) {
            text-align: left;
        }

        .about-culture__entry:nth-child(2) .about-culture__label {
            justify-content: flex-start;
        }
    }
</style>
