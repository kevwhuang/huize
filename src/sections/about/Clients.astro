---
import SectionHead from '@components/SectionHead.astro';
import { getEditId, getSection } from '@lib/database';

const clients = await getSection('about-clients');

const groups = clients.groups?.clients ?? [];
---

<section
    class="about-clients section section--tint"
    aria-labelledby="about-clients-title"
>
    <div class="shell">
        <SectionHead
            editKey="sections/about-clients.heading"
            eyebrow={clients.eyebrow ?? ''}
            headingId="about-clients-title"
        >
            {clients.heading}
            <Fragment slot="text">
                <p
                    data-edit="sections/about-clients.lead"
                    data-edit-id={getEditId('sections/about-clients.lead')}
                >
                    {clients.lead}
                </p>
            </Fragment>
        </SectionHead>
        <div class="about-clients__groups">
            {groups.map((group, index) => (
                <div
                    class="about-clients__group"
                    data-scroll={index === 0 ? 'left' : 'right'}
                >
                    <h3 class="about-clients__label">
                        <span>{group.label}</span>
                        <span
                            class="label label--gold"
                            aria-hidden="true"
                            lang="en"
                        >
                            {group.english}
                        </span>
                    </h3>
                    <ul class="about-clients__list">
                        {(group.tags ?? []).map((name, position) => (
                            <li
                                class="about-clients__item"
                                data-edit={`sections/about-clients.groups.clients.${index}.tags.${position}`}
                                data-edit-id={getEditId(`sections/about-clients.groups.clients.${index}.tags.${position}`)}
                            >
                                {name}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .about-clients__group {
        border-top: 0.125rem solid var(--color-laurel);
        padding-top: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
    }

    .about-clients__groups {
        display: grid;
        gap: clamp(2rem, calc(1.54rem + 2.29vw), 3.375rem);
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .about-clients__item {
        background: var(--color-white);
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-card);
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: var(--text-small);
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 1rem 0.75rem;
        text-align: center;
    }

    .about-clients__label {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        font-size: var(--text-h3);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .about-clients__list {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        list-style: none;
        padding: 0;
    }

    @media (max-width: 1024px) {
        .about-clients__groups {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
