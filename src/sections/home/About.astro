---
import SectionHead from '@components/SectionHead.astro';
import logoIcon from '@images/logos/icon.webp';
import { getEditId, getSection } from '@lib/database';

const homeAbout = await getSection('home-about');

const headingLines = (homeAbout.heading ?? '').split('\n');
const { highlights = [] } = homeAbout.groups ?? {};
---

<section
    class="home-about section"
    aria-labelledby="home-about-title"
>
    <div class="home-about__grid shell">
        <div
            class="home-about__media"
            data-scroll="left"
        >
            <div class="home-about__frame">
                <div
                    class="home-about__photo"
                    aria-hidden="true"
                />
                <div
                    class="home-about__scrim"
                    aria-hidden="true"
                />
                <p class="home-about__badge">
                    <img
                        class="home-about__badge-mark"
                        alt=""
                        height={32}
                        src={logoIcon.src}
                        width={32}
                    />
                    <span
                        data-edit="sections/home-about.badge"
                        data-edit-id={getEditId('sections/home-about.badge')}
                    >
                        {homeAbout.badge}
                    </span>
                </p>
            </div>
        </div>
        <div data-scroll="right">
            <SectionHead
                editKey="sections/home-about.heading"
                eyebrow={homeAbout.eyebrow ?? ''}
                headingId="home-about-title"
            >
                {headingLines.map((line, index) => (index > 0 ? <Fragment><br />{line}</Fragment> : line))}
            </SectionHead>
            <p
                class="home-about__text"
                data-edit="sections/home-about.lead"
                data-edit-id={getEditId('sections/home-about.lead')}
            >
                {homeAbout.lead}
            </p>
            <ul class="home-about__highlights">
                {highlights.map((highlight, index) => (
                    <li>
                        <span
                            class="home-about__bullet"
                            aria-hidden="true"
                        />
                        <span
                            data-edit={`sections/home-about.groups.highlights.${index}.text`}
                            data-edit-id={getEditId(`sections/home-about.groups.highlights.${index}.text`)}
                        >
                            {highlight.text}
                        </span>
                    </li>
                ))}
            </ul>
            <a
                class="link-more"
                href="/about"
            >
                了解更多
            </a>
        </div>
    </div>
</section>

<style>
    .home-about__badge {
        align-items: center;
        background: var(--color-white-90);
        border-radius: var(--radius-pill);
        bottom: 1rem;
        box-shadow: var(--shadow-lift);
        color: var(--color-pine);
        display: inline-flex;
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 700;
        gap: 0.75rem;
        left: 1rem;
        letter-spacing: 0.04em;
        margin-bottom: 0;
        padding: 0.5rem 1.125rem 0.5rem 0.625rem;
        position: absolute;
    }

    .home-about__badge-mark {
        height: 2rem;
        width: 2rem;
    }

    .home-about__bullet {
        background: var(--color-jade);
        border-radius: 50%;
        flex-shrink: 0;
        height: 0.5rem;
        translate: 0 0.5rem;
        width: 0.5rem;
    }

    .home-about__frame {
        background: linear-gradient(160deg, var(--color-jade), var(--color-pine));
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-lift);
        inset: 0;
        overflow: clip;
        position: absolute;
    }

    .home-about__grid {
        align-items: center;
        display: grid;
        gap: var(--space-split);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }

    .home-about__highlights {
        display: grid;
        gap: 0.875rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        list-style: none;
        margin-bottom: 2rem;
        padding: 0;
    }

    .home-about__highlights li {
        align-items: start;
        color: var(--color-sage-dark);
        display: flex;
        font-size: 0.875rem;
        gap: 0.75rem;
        line-height: 1.5;
    }

    .home-about__media {
        min-height: clamp(20rem, 38vw, 28.75rem);
        position: relative;
    }

    .home-about__photo {
        background-color: var(--color-pine);
        background-image: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1000&q=80');
        background-position: center;
        background-size: cover;
        inset: 0;
        position: absolute;
    }

    .home-about__scrim {
        background: linear-gradient(160deg, var(--color-veil-10) 35%, var(--color-veil-80));
        inset: 0;
        position: absolute;
    }

    .home-about__text {
        color: var(--color-sage);
        font-weight: 400;
        line-height: 2;
        margin-bottom: 1.875rem;
    }

    @media (max-width: 1024px) {
        .home-about__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .home-about__highlights {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .home-about__highlights {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
