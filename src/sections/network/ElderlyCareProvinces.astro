---
import SectionHead from '@components/SectionHead.astro';
import { PERCENT_SCALE } from '@lib/constants';
import { getEditId, getProvinces, getSection } from '@lib/database';

const provinces = await getProvinces();
const section = await getSection('network-elderly-care-provinces');

const [headingCopy] = section.groups?.heading ?? [];
const [largest] = provinces;

const heading = `${provinces.length} ${headingCopy?.suffix ?? ''}`;
---

<section
    class="provinces section"
    aria-labelledby="provinces-title"
>
    <div class="shell">
        <SectionHead
            eyebrow={section.eyebrow ?? ''}
            headingId="provinces-title"
        >
            {heading}
            <Fragment slot="text">
                <p
                    data-edit="sections/network-elderly-care-provinces.lead"
                    data-edit-id={getEditId('sections/network-elderly-care-provinces.lead')}
                >
                    {section.lead}
                </p>
            </Fragment>
        </SectionHead>
        <ol
            class="provinces__list"
            data-scroll="up"
            data-scroll-stagger
        >
            {provinces.map(province => (
                <li class="card provinces__item">
                    <h3 class="provinces__name">{province.data.name}</h3>
                    <p class="provinces__count stat">
                        {province.data.institutions}{' '}
                        <span
                            data-edit="sections/network-elderly-care-provinces.caption"
                            data-edit-id={getEditId('sections/network-elderly-care-provinces.caption')}
                        >
                            {section.caption}
                        </span>
                    </p>
                    <p class="provinces__cities">
                        {province.data.cities}{' '}
                        <span
                            data-edit="sections/network-elderly-care-provinces.note"
                            data-edit-id={getEditId('sections/network-elderly-care-provinces.note')}
                        >
                            {section.note}
                        </span>
                        {province.data.sample.join('、')}
                    </p>
                    <div
                        class="provinces__bar"
                        aria-hidden="true"
                        style={`--share:${Math.round((province.data.institutions / largest.data.institutions) * PERCENT_SCALE)}%`}
                    />
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .provinces__bar {
        background: var(--color-mint);
        border-radius: var(--radius-pill);
        grid-column: 1 / -1;
        height: 0.25rem;
        overflow: clip;
        position: relative;
    }

    .provinces__bar::after {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--share);
    }

    .provinces__cities {
        color: var(--color-sage);
        font-size: var(--text-meta);
        grid-column: 1 / -1;
        line-height: 1.75;
        margin-bottom: 0;
    }

    .provinces__count {
        font-size: 1.375rem;
        margin-bottom: 0;
        text-align: right;
        white-space: nowrap;
    }

    .provinces__item {
        align-items: baseline;
        column-gap: 1rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 1.25rem 1.375rem;
        row-gap: 0.625rem;
    }

    .provinces__item:hover {
        border-color: var(--color-laurel);
        box-shadow: var(--shadow-lift);
    }

    .provinces__list {
        display: grid;
        gap: 0.875rem;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .provinces__name {
        font-size: var(--text-lead);
        margin-bottom: 0;
    }
</style>
