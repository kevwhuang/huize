---
import Check from '@components/icons/Check.astro';
import SectionHead from '@components/SectionHead.astro';
import { PERCENT_SCALE } from '@lib/constants';
import { getEditId, getProvinces, getSection, getSite } from '@lib/database';

const CANDIDATE_POOL = 40_000;

const provinces = await getProvinces();
const section = await getSection('network-elderly-care-stats');
const site = await getSite();

const criteria = section.groups?.criteria ?? [];
const headingLines = (section.heading ?? '').split('\n');
const stageValues = [CANDIDATE_POOL, site.totalInstitutions];

const [coverage] = section.groups?.provinces ?? [];

const coverageNote = `${coverage?.text ?? ''} ${provinces.length} ${coverage?.suffix ?? ''}`;

const stages = (section.groups?.stages ?? []).map((stage, index) => ({
    label: stage.label,
    share: Math.round((stageValues[index] / CANDIDATE_POOL) * PERCENT_SCALE),
    suffix: stage.suffix,
    value: stageValues[index],
}));
---

<section
    class="elderly-stats section section--tint"
    aria-labelledby="elderly-stats-title"
>
    <div class="elderly-stats__grid shell">
        <div data-scroll="left">
            <SectionHead
                editKey="sections/network-elderly-care-stats.heading"
                eyebrow={section.eyebrow ?? ''}
                headingId="elderly-stats-title"
            >
                {headingLines.map((line, index) => (index > 0 ? <Fragment><br />{line}</Fragment> : line))}
                <Fragment slot="text">
                    <p
                        data-edit="sections/network-elderly-care-stats.lead"
                        data-edit-id={getEditId('sections/network-elderly-care-stats.lead')}
                    >
                        {section.lead}
                    </p>
                </Fragment>
            </SectionHead>
            <ul class="elderly-stats__criteria">
                {criteria.map((criterion, index) => (
                    <li>
                        <span
                            class="check elderly-stats__check"
                            aria-hidden="true"
                        >
                            <Check size={12} strokeWidth={3} />
                        </span>
                        <span
                            data-edit={`sections/network-elderly-care-stats.groups.criteria.${index}.text`}
                            data-edit-id={getEditId(`sections/network-elderly-care-stats.groups.criteria.${index}.text`)}
                        >
                            {criterion.text}
                        </span>
                    </li>
                ))}
            </ul>
        </div>
        <ol
            class="elderly-stats__funnel"
            data-scroll="right"
        >
            {stages.map(stage => (
                <li class="elderly-stats__stage">
                    <p class="elderly-stats__stage-label">{stage.label}</p>
                    <p
                        class="elderly-stats__stage-value stat"
                        data-count-to={stage.value}
                        data-suffix={stage.suffix}
                    >
                        {stage.value}{stage.suffix}
                    </p>
                    <div
                        class="elderly-stats__bar"
                        aria-hidden="true"
                        style={`--share:${stage.share}%`}
                    />
                </li>
            ))}
            <li class="elderly-stats__stage">
                <p class="elderly-stats__stage-label">{coverage?.label}</p>
                <p
                    class="elderly-stats__stage-value stat"
                    data-count-to={provinces.length}
                >
                    {provinces.length}
                </p>
                <p class="elderly-stats__stage-note">
                    {coverageNote}
                </p>
            </li>
        </ol>
    </div>
</section>

<style>
    .elderly-stats {
        --space-row: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
    }

    .elderly-stats__bar {
        background: var(--color-shell);
        border-radius: var(--radius-pill);
        height: 0.375rem;
        overflow: clip;
        position: relative;
    }

    .elderly-stats__bar::after {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--share);
    }

    .elderly-stats__check {
        translate: 0 0.125rem;
    }

    .elderly-stats__criteria {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        padding: 0;
    }

    .elderly-stats__criteria li {
        align-items: start;
        color: var(--color-sage-dark);
        display: flex;
        gap: 0.75rem;
        line-height: 1.6;
    }

    .elderly-stats__funnel {
        background: var(--color-white);
        border: var(--border-soft);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-lift);
        display: grid;
        gap: var(--space-row);
        list-style: none;
        padding: var(--pad-panel);
    }

    .elderly-stats__grid {
        align-items: center;
        display: grid;
        gap: var(--space-split);
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .elderly-stats__stage + .elderly-stats__stage {
        border-top: 0.0625rem solid var(--color-snow);
        padding-top: var(--space-row);
    }

    .elderly-stats__stage-label {
        color: var(--color-sage);
        font-size: 0.875rem;
        letter-spacing: 0.06em;
        margin-bottom: 0.375rem;
    }

    .elderly-stats__stage-note {
        color: var(--color-sage);
        font-size: 0.875rem;
        line-height: 1.9;
        margin-bottom: 0;
    }

    .elderly-stats__stage-value {
        margin-bottom: 0.5rem;
    }

    .elderly-stats__stage-value:has(+ .elderly-stats__bar) {
        margin-bottom: 0.875rem;
    }

    @media (max-width: 1024px) {
        .elderly-stats__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
