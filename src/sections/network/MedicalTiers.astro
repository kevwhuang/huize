---
import SectionHead from '@components/SectionHead.astro';
import { getEditId, getSection, getSite } from '@lib/database';

const section = await getSection('network-medical');
const site = await getSite();

const tiers = section.groups?.tiers ?? [];
---

<section
    class="medical section"
    aria-labelledby="medical-title"
>
    <div class="shell">
        <SectionHead
            editKey="sections/network-medical.heading"
            eyebrow={section.eyebrow ?? ''}
            headingId="medical-title"
        >
            {section.heading}
            <Fragment slot="text">
                <p
                    data-edit="sections/network-medical.lead"
                    data-edit-id={getEditId('sections/network-medical.lead')}
                >
                    {section.lead}
                </p>
            </Fragment>
        </SectionHead>
        <ol
            class="medical__tiers"
            data-scroll="up"
            data-scroll-stagger="0.2"
        >
            {tiers.map(tier => (
                <li class="medical__tier">
                    <span
                        class="medical__tier-number numeral numeral--gold"
                        aria-hidden="true"
                    >
                        {tier.number}
                    </span>
                    <h3>{tier.title}</h3>
                </li>
            ))}
        </ol>
        <div
            class="medical__band"
            data-scroll="scale"
        >
            <div
                class="glow medical__band-glow"
                aria-hidden="true"
            />
            <p class="medical__band-figure">
                <span
                    class="medical__band-value stat stat--on-dark"
                    data-count-to={site.publicHospitals}
                >
                    {site.publicHospitals}
                </span>{' '}
                <span
                    class="medical__band-unit"
                    data-edit="sections/network-medical.caption"
                    data-edit-id={getEditId('sections/network-medical.caption')}
                >
                    {section.caption}
                </span>
            </p>
            <p
                class="medical__band-text"
                data-edit="sections/network-medical.note"
                data-edit-id={getEditId('sections/network-medical.note')}
            >
                {section.note}
            </p>
        </div>
    </div>
</section>

<style>
    .medical {
        --space-band: clamp(1.25rem, calc(0.83rem + 2.08vw), 2.5rem);
    }

    .medical__band {
        align-items: center;
        background: var(--color-pine);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-panel);
        display: grid;
        gap: var(--space-band);
        grid-template-columns: minmax(0, auto) minmax(0, 1fr);
        overflow: clip;
        padding: clamp(2rem, calc(1.58rem + 2.08vw), 3.25rem);
        position: relative;
    }

    .medical__band-figure {
        margin-bottom: 0;
        position: relative;
    }

    .medical__band-glow {
        left: -6.25rem;
        top: -9.375rem;
    }

    .medical__band-text {
        color: var(--color-white-70);
        line-height: 1.9;
        margin-bottom: 0;
        position: relative;
    }

    .medical__band-unit {
        color: var(--color-reef);
        display: block;
        font-size: var(--text-small);
    }

    .medical__band-value {
        display: block;
        font-size: clamp(2.5rem, calc(1.92rem + 2.92vw), 4.25rem);
        margin-bottom: 0.5rem;
    }

    .medical__tier {
        align-items: baseline;
        border-top: 0.0625rem solid var(--color-shell);
        display: flex;
        gap: clamp(1rem, calc(0.58rem + 2.08vw), 2.25rem);
        padding-block: var(--space-band);
    }

    .medical__tier:last-child {
        border-bottom: 0.0625rem solid var(--color-shell);
    }

    .medical__tier h3 {
        font-size: clamp(1.5rem, calc(1.25rem + 1.25vw), 2.25rem);
        margin-bottom: 0;
    }

    .medical__tier-number {
        flex-shrink: 0;
    }

    .medical__tiers {
        list-style: none;
        margin-bottom: var(--space-split);
        padding: 0;
    }

    .stat--on-dark {
        color: var(--color-white);
    }

    @media (max-width: 1024px) {
        .medical__band {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
