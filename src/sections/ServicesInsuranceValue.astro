---
import IconArrow from '@components/IconArrow.astro';
import IconCheck from '@components/IconCheck.astro';
import IconGlobe from '@components/IconGlobe.astro';
import IconHeart from '@components/IconHeart.astro';
import IconShield from '@components/IconShield.astro';
import SectionHead from '@components/SectionHead.astro';

const LINES = ['寿险', '健康险', '车险'];

const OFFERINGS = [
    { Icon: IconArrow, text: '覆盖全国500个城市、11000家二级及以上公立医院，副主任及以上医师，VIP门诊绿通与VIP手术绿通。', title: '就医绿通' },
    { Icon: IconHeart, text: '7&ndash;15天院内一对一护理，让住院期间的照护有专业团队接手。', title: '院内护理' },
    { Icon: IconShield, text: '30天康复医院住院报销，180天居家康复跟踪，全国专科康复医院绿通与专车转院。', title: '术后康复' },
    { Icon: IconGlobe, text: '药安心&middot;全球药械专享服务，把稀缺的医疗资源与先进药械更便捷地送到客户手中。', title: '全球药械' },
    { Icon: IconCheck, text: '2000+种三折药品选择，覆盖家中常备药品，全家可用，10000家门店配送。', title: '普药购药' },
];
---

<section
    class="services-insurance-value section"
    aria-labelledby="services-insurance-value-title"
>
    <div class="shell services-insurance-value__grid">
        <div data-scroll="left">
            <SectionHead
                eyebrow="Value-added Service"
                headingId="services-insurance-value-title"
            >
                商保公司健康增值服务
                <Fragment slot="text">
                    <p>无论是寿险、健康险还是车险，为客户提供有温度的健康增值服务，一直是各大保险公司追求的目标。</p>
                </Fragment>
            </SectionHead>
            <ul class="services-insurance-value__lines">
                {LINES.map(line => (
                    <li class="tag">{line}</li>
                ))}
            </ul>
            <div class="prose">
                <p>惠泽为商保公司提供一站式健康增值服务，链接保险客户与康养机构、医疗机构、服务机构，把线上平台与线下实体网络组合成可交付的权益包。</p>
            </div>
        </div>

        <ul
            class="services-insurance-value__offerings"
            data-scroll="right"
            data-scroll-stagger
        >
            {OFFERINGS.map(({ Icon, text, title }) => (
                <li class="services-insurance-value__offering">
                    <span
                        class="services-insurance-value__icon"
                        aria-hidden="true"
                    >
                        <Icon size={16} strokeWidth={2} />
                    </span>
                    <div class="services-insurance-value__body">
                        <h3>{title}</h3>
                        <span
                            class="services-insurance-value__text"
                            set:html={text}
                        />
                    </div>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .services-insurance-value__body {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        min-width: 0;
    }

    .services-insurance-value__body h3 {
        font-size: 1.0625rem;
        margin-bottom: 0;
    }

    .services-insurance-value__grid {
        display: grid;
        gap: clamp(2.5rem, calc(1.83rem + 3.33vw), 4.5rem);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .services-insurance-value__icon {
        align-items: center;
        background: var(--color-mint);
        border-radius: 50%;
        color: var(--color-jade);
        display: flex;
        flex-shrink: 0;
        height: 2.25rem;
        justify-content: center;
        width: 2.25rem;
    }

    .services-insurance-value__lines {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin-bottom: 1.75rem;
        padding: 0;
    }

    .services-insurance-value__offering {
        align-items: start;
        background: #FFFFFF;
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-card);
        display: flex;
        gap: 1rem;
        padding: 1.125rem 1.25rem;
    }

    .services-insurance-value__offerings {
        display: grid;
        gap: 0.875rem;
        list-style: none;
        padding: 0;
    }

    .services-insurance-value__text {
        color: var(--color-sage);
        font-size: 0.875rem;
        line-height: 1.75;
    }

    @media (max-width: 1024px) {
        .services-insurance-value__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
