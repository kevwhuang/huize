---
import SectionHead from '@components/SectionHead.astro';

const CLIENT_GROUPS = [
    {
        english: 'Insurers',
        label: '商保客户',
        names: ['中国人寿', '平安健康', '新华人寿', '阳光人寿', '百年人寿', '太平洋保险', '招商仁和人寿'],
    },
    {
        english: 'Enterprises',
        label: '企业客户',
        names: ['美年大健康', '世茂集团', '绿城服务', '神州高铁'],
    },
];
---

<section
    class="about-clients section section--tint"
    aria-labelledby="about-clients-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Clients"
            headingId="about-clients-title"
        >
            服务保险机构与大型企业客户
            <Fragment slot="text">
                <p>惠泽平台链接保险客户、企业客户与个人客户，为合作伙伴提供健康管理与康养照护的一站式服务。</p>
            </Fragment>
        </SectionHead>

        <div class="about-clients__groups">
            {CLIENT_GROUPS.map((group, index) => (
                <div
                    class="about-clients__group"
                    data-scroll={index === 0 ? 'left' : 'right'}
                >
                    <h3 class="about-clients__label">
                        {group.label}
                        <span
                            class="label label--gold"
                            aria-hidden="true"
                            lang="en"
                        >{group.english}
                        </span>
                    </h3>
                    <ul class="about-clients__list">
                        {group.names.map(name => (
                            <li class="about-clients__item">{name}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .about-clients__group {
        border-top: 0.125rem solid var(--color-laurel);
        padding-top: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
    }

    .about-clients__groups {
        display: grid;
        gap: clamp(2rem, calc(1.42rem + 2.92vw), 3.375rem);
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .about-clients__item {
        background: #FFFFFF;
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-card);
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 1.0625rem 0.75rem;
        text-align: center;
    }

    .about-clients__label {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        font-size: var(--text-h3);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .about-clients__list {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        list-style: none;
        padding: 0;
    }

    @media (max-width: 1024px) {
        .about-clients__groups {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
