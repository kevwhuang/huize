---
import SectionHead from '@components/SectionHead.astro';
import { BASE_THEMES, BASES } from '@lib/constants';

const grouped = new Map<string, string[]>();

for (const base of BASES) {
    const names = grouped.get(base.region) ?? [];

    names.push(base.name);
    grouped.set(base.region, names);
}

const regions = [...grouped]
    .map(([name, names]) => ({ name, names }))
    .sort((first, second) => second.names.length - first.names.length);
---

<section
    class="bases section"
    aria-labelledby="bases-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Wellness Bases"
            headingId="bases-title"
        >
            {BASES.length} 个康养疗愈基地
            <Fragment slot="text">
                <p>
                    依托优质自然与医疗资源打造的旅居康养与疗愈目的地，分布在 {regions.length} 个省级区域，服务健康人群与活力老人的身心灵整体疗愈。
                </p>
            </Fragment>
        </SectionHead>

        <ul
            class="bases__themes"
            aria-label="基地主题"
            data-scroll="up"
            data-scroll-stagger
        >
            {BASE_THEMES.map(theme => (
                <li class="tag">{theme}</li>
            ))}
        </ul>

        <ol class="bases__regions">
            {regions.map((region, index) => (
                <li
                    class="bases__region"
                    data-scroll={index % 2 === 0 ? 'left' : 'right'}
                >
                    <div class="bases__region-head">
                        <h3>{region.name}</h3>
                        <p class="bases__region-count">{region.names.length} 个基地</p>
                    </div>
                    <ul class="bases__list">
                        {region.names.map(name => (
                            <li class="bases__item">{name}</li>
                        ))}
                    </ul>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .bases__item {
        background: #FFFFFF;
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-card);
        color: var(--color-pine);
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.6;
        padding: 0.9375rem 1.0625rem;
        transition:
            border-color var(--duration-fast) var(--ease-out),
            box-shadow var(--duration-fast) var(--ease-out);
    }

    .bases__item:hover {
        border-color: var(--color-laurel);
        box-shadow: var(--shadow-lift);
    }

    .bases__list {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .bases__region {
        align-items: start;
        display: grid;
        gap: clamp(1rem, calc(0.58rem + 2.08vw), 2.25rem);
        grid-template-columns: 11rem minmax(0, 1fr);
    }

    .bases__region-count {
        color: var(--color-sage);
        font-size: 0.8125rem;
        letter-spacing: 0.08em;
        margin-bottom: 0;
    }

    .bases__region-head h3 {
        margin-bottom: 0.375rem;
    }

    .bases__regions {
        display: grid;
        gap: clamp(2rem, calc(1.5rem + 2.5vw), 3.5rem);
        list-style: none;
        padding: 0;
    }

    .bases__themes {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        list-style: none;
        margin-bottom: clamp(2.25rem, calc(1.83rem + 2.08vw), 3.5rem);
        padding: 0;
    }

    @media (max-width: 1024px) {
        .bases__region {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
