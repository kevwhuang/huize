---
import IconCheck from '@components/IconCheck.astro';
import SectionHead from '@components/SectionHead.astro';

const PROGRAMS = [
    {
        english: 'Green Channel',
        items: [
            '全国500个城市，11000家医疗机构',
            '副主任及以上医师',
            'VIP门诊绿通和VIP手术绿通',
            '就医陪诊',
            '7&times;24小时无限次视频医生',
        ],
        number: '01',
        title: '就医绿通',
    },
    {
        english: 'Rehabilitation',
        items: [
            '7&ndash;15天院内一对一护理',
            '30天康复医院住院报销',
            '180天居家康复跟踪',
            '全国专科康复医院绿通',
            '专车转院',
        ],
        number: '02',
        title: '康复护理',
    },
    {
        english: 'Pharmacy',
        items: [
            '2000+种三折药品选择',
            '46大类、293个小类的疾病',
            '覆盖家中常备药品，不限量不限次',
            '全家可用，7&times;24小时自选',
            '10000家门店配送',
        ],
        number: '03',
        title: '折扣购药',
    },
];
---

<section
    class="services-health-programs section section--tint"
    aria-labelledby="services-health-programs-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="What We Cover"
            headingId="services-health-programs-title"
        >
            围绕就医痛点的三条服务线
            <Fragment slot="text">
                <p>就医绿通、康复护理与折扣购药，覆盖从看病、住院到回家用药的完整链路。</p>
            </Fragment>
        </SectionHead>

        <ul
            class="services-health-programs__list"
            data-scroll="scale"
            data-scroll-stagger="0.12"
        >
            {PROGRAMS.map(program => (
                <li>
                    <article class="card services-health-programs__card">
                        <p class="services-health-programs__meta">
                            <span class="numeral">{program.number}</span>
                            <span
                                class="label label--gold"
                                lang="en"
                            >
                                {program.english}
                            </span>
                        </p>
                        <h3>{program.title}</h3>
                        <ul class="services-health-programs__items">
                            {program.items.map(item => (
                                <li>
                                    <span
                                        class="check services-health-programs__check"
                                        aria-hidden="true"
                                    >
                                        <IconCheck size={11} strokeWidth={3} />
                                    </span>
                                    <span set:html={item} />
                                </li>
                            ))}
                        </ul>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .services-health-programs__card {
        display: grid;
        gap: 1rem;
        height: 100%;
    }

    .services-health-programs__card h3 {
        margin-bottom: 0;
    }

    .services-health-programs__check {
        margin-top: 0.1875rem;
    }

    .services-health-programs__items {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        padding: 0;
    }

    .services-health-programs__items li {
        align-items: start;
        color: var(--color-sage);
        display: flex;
        font-size: 0.9rem;
        gap: 0.6875rem;
        line-height: 1.7;
    }

    .services-health-programs__list {
        display: grid;
        gap: clamp(1.5rem, calc(1.17rem + 1.67vw), 2.5rem);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        list-style: none;
        padding: 0;
    }

    .services-health-programs__meta {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0;
    }

    @media (max-width: 1024px) {
        .services-health-programs__list {
            grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        }
    }

</style>
