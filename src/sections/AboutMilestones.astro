---
import SectionHead from '@components/SectionHead.astro';

const MILESTONES = [
    { countTo: 40, label: '实体机构', suffix: '+' },
    { countTo: 15_000, label: '总床位数', suffix: '' },
    { countTo: 18, label: '机构分布城市', suffix: '' },
    { countTo: 500, label: '服务城市', suffix: '+' },
    { countTo: 1_000, label: '累计服务人次', suffix: '万+' },
];

const START_YEAR = '2012';
---

<section
    class="about-milestones section section--dark"
    aria-labelledby="about-milestones-title"
>
    <div class="shell about-milestones__grid">
        <div data-scroll="left">
            <SectionHead
                eyebrow="Milestones"
                headingId="about-milestones-title"
                isOnDark
            >
                十余年实体运营，康养与医疗网络遍布全国
                <Fragment slot="text">
                    <p>从2012年起，创始团队在全国各地运营管理实体医疗机构、康复机构和养老连锁机构。</p>
                </Fragment>
            </SectionHead>
        </div>

        <dl
            class="about-milestones__stats"
            data-scroll="scale"
            data-scroll-stagger
        >
            <div class="about-milestones__stat">
                <dt class="about-milestones__label">深耕康养起点</dt>
                <dd class="about-milestones__value">
                    {START_YEAR}<span class="about-milestones__unit">年起</span>
                </dd>
            </div>
            {MILESTONES.map(milestone => (
                <div class="about-milestones__stat">
                    <dt class="about-milestones__label">{milestone.label}</dt>
                    <dd
                        class="about-milestones__value"
                        data-count-to={milestone.countTo}
                        data-suffix={milestone.suffix}
                    >
                        {milestone.countTo}{milestone.suffix}
                    </dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .about-milestones__grid {
        align-items: center;
        display: grid;
        gap: clamp(2.5rem, calc(1.67rem + 4.17vw), 4.5rem);
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }

    .about-milestones__label {
        color: var(--color-white-70);
        font-size: 0.84rem;
        letter-spacing: 0.04em;
        line-height: 1.5;
    }

    .about-milestones__stat {
        border-top: 0.0625rem solid var(--color-white-12);
        display: flex;
        flex-direction: column-reverse;
        gap: 0.5rem;
        padding-top: 1.125rem;
    }

    .about-milestones__stats {
        display: grid;
        gap: clamp(1.5rem, calc(1.08rem + 2.08vw), 2.5rem);
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .about-milestones__unit {
        font-size: 0.5em;
        letter-spacing: 0.06em;
        margin-left: 0.25em;
    }

    .about-milestones__value {
        color: var(--color-gold-light);
        font-family: var(--font-display);
        font-size: clamp(1.6rem, calc(1.3rem + 1.5vw), 2.5rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 0;
        white-space: nowrap;
    }

    @media (max-width: 1024px) {
        .about-milestones__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
