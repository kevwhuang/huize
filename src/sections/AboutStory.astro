---
import SectionHead from '@components/SectionHead.astro';
import { LINKS } from '@lib/constants';

const DEMAND = ['保险客户', '企业客户', '个人客户'];

const FACTS = [
    { label: '公司名称', value: LINKS.company },
    { label: '上海总部', value: LINKS.address },
    { label: '官方网站', value: LINKS.website },
];

const SUPPLY = ['康养机构', '医疗机构', '服务机构'];
---

<section
    class="about-story section"
    aria-labelledby="about-story-title"
>
    <div class="shell about-story__grid">
        <div data-scroll="left">
            <SectionHead
                eyebrow="Company Profile"
                headingId="about-story-title"
            >
                全流程、一站式的<br />养老服务与健康管理
            </SectionHead>
            <p class="about-story__text">
                上海惠泽是一家数字健康科技公司，提供全流程、一站式的养老服务和健康管理服务。通过惠泽平台，链接保险客户、企业客户、个人客户和康养机构、医疗机构、服务机构等，打通上下游供需，赋能合作伙伴共同发展。
            </p>
            <dl class="about-story__facts">
                {FACTS.map(fact => (
                    <div class="about-story__fact">
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                    </div>
                ))}
            </dl>
        </div>

        <div data-scroll="right">
            <div class="about-story__panel">
                <div>
                    <h3 class="about-story__side">
                        需求端
                        <span
                            class="label label--on-dark"
                            aria-hidden="true"
                            lang="en"
                        >Demand
                        </span>
                    </h3>
                    <ul class="about-story__chips">
                        {DEMAND.map(item => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
                <p class="about-story__hub">惠泽平台</p>
                <div>
                    <h3 class="about-story__side">
                        供给端
                        <span
                            class="label label--on-dark"
                            aria-hidden="true"
                            lang="en"
                        >Supply
                        </span>
                    </h3>
                    <ul class="about-story__chips">
                        {SUPPLY.map(item => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about-story__chips {
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .about-story__chips li {
        background: var(--color-white-08);
        border: 0.0625rem solid var(--color-white-12);
        border-radius: var(--radius-card-sm);
        color: #FFFFFF;
        font-size: 0.9rem;
        padding: 0.8125rem 0.5rem;
        text-align: center;
    }

    .about-story__fact dd {
        color: var(--color-pine);
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .about-story__fact dt {
        color: var(--color-sage);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        margin-bottom: 0.3125rem;
    }

    .about-story__facts {
        border-top: var(--border-soft);
        display: grid;
        gap: 1.125rem;
        padding-top: 1.75rem;
    }

    .about-story__grid {
        align-items: center;
        display: grid;
        gap: clamp(2.5rem, calc(1.67rem + 4.17vw), 4.5rem);
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .about-story__hub {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        color: #FFFFFF;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        margin-bottom: 0;
        margin-inline: auto;
        padding: 0.625rem 1.5rem;
        position: relative;
        width: fit-content;
    }

    .about-story__hub::after,
    .about-story__hub::before {
        background: var(--color-white-12);
        content: '';
        height: 1.5rem;
        left: 50%;
        position: absolute;
        width: 0.0625rem;
    }

    .about-story__hub::after {
        top: 100%;
    }

    .about-story__hub::before {
        bottom: 100%;
    }

    .about-story__panel {
        background: linear-gradient(160deg, var(--color-pine), var(--color-forest));
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-panel);
        display: grid;
        gap: 1.5rem;
        padding: clamp(1.75rem, calc(1.42rem + 1.67vw), 2.5rem);
    }

    .about-story__side {
        align-items: baseline;
        color: #FFFFFF;
        display: flex;
        flex-wrap: wrap;
        font-size: 1rem;
        gap: 0.625rem;
        margin-bottom: 0.875rem;
    }

    .about-story__text {
        color: var(--color-sage);
        line-height: 2.05;
        margin-bottom: 2rem;
    }

    @media (max-width: 1024px) {
        .about-story__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
