---
import Douyin from '@components/icons/Douyin.astro';
import Qr from '@components/Qr.astro';
import Shield from '@components/icons/Shield.astro';
import Wechat from '@components/icons/Wechat.astro';
import Weibo from '@components/icons/Weibo.astro';
import Xiaohongshu from '@components/icons/Xiaohongshu.astro';
import logoIcon from '@images/logos/icon.webp';
import { BRAND, LINKS, ROUTES } from '@lib/constants';

const FOOTER_ROUTES = ROUTES.filter(route => route.path !== '/');

const SOCIALS = [
    { Icon: Wechat, href: LINKS.wechat, label: '微信公众号' },
    { Icon: Weibo, label: '新浪微博' },
    { Icon: Douyin, label: '抖音' },
    { Icon: Xiaohongshu, label: '小红书' },
];
---

<footer class="footer">
    <div class="footer__inner shell">
        <div class="footer__grid">
            <div class="footer__brand-col">
                <a
                    class="footer__logo"
                    href="/"
                >
                    <span class="footer__logo-icon">
                        <img
                            alt=""
                            height={30}
                            src={logoIcon.src}
                            width={30}
                        />
                    </span>
                    <span class="footer__logo-text">
                        <span class="footer__logo-zh">{BRAND.zh}</span>
                        <span
                            class="footer__logo-en"
                            lang="en"
                        >
                            {BRAND.en}
                        </span>
                    </span>
                </a>
                <p class="footer__desc">数字健康科技平台，提供全流程、一站式的养老服务和健康管理服务。</p>
                <ul class="footer__socials">
                    {SOCIALS.map(({ Icon, href, label }) => (
                        <li>
                            {href
                                ? (
                                        <a
                                            class="footer__social"
                                            aria-label={label}
                                            href={href}
                                            rel="noopener noreferrer"
                                            target="_blank"
                                        >
                                            <Icon size={16} />
                                        </a>
                                    )
                                : (
                                        <span class="footer__social footer__social--pending">
                                            <Icon size={16} />
                                            <span class="sr-only">{label}（敬请期待）</span>
                                        </span>
                                    )}
                        </li>
                    ))}
                </ul>
            </div>
            {FOOTER_ROUTES.map(route => (
                <nav
                    class="footer__col"
                    aria-label={route.label}
                >
                    <h2 class="footer__heading">{route.label}</h2>
                    <ul class="footer__links">
                        {(route.children ?? [route]).map(child => (
                            <li>
                                <a
                                    class="footer__link"
                                    href={child.path}
                                >
                                    {child.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))}
            <div class="footer__qr-col">
                <h2 class="footer__heading">关注公众号</h2>
                <a
                    class="footer__qr"
                    aria-label="关注惠泽健康微信公众号"
                    href={LINKS.wechat}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <Qr size={102} />
                </a>
                <p class="footer__qr-label">扫码关注 &middot; 惠泽康护</p>
            </div>
        </div>
        <div class="footer__contact">
            <a
                class="footer__contact-link"
                href={LINKS.hotlineHref}
            >
                {LINKS.hotlineLabel} {LINKS.hotline}
            </a>
            <a
                class="footer__contact-link"
                href={LINKS.shanghaiHref}
            >
                {LINKS.shanghaiLabel} {LINKS.shanghai}
            </a>
            <span>{LINKS.address}</span>
        </div>
        <div class="footer__legal">
            <span>Copyright 2019&ndash;2026 {LINKS.company}</span>
            <a
                href={LINKS.icpHref}
                rel="noopener noreferrer"
                target="_blank"
            >
                {LINKS.icp}
            </a>
            <a
                class="footer__legal-badge"
                href={LINKS.policeHref}
                rel="noopener noreferrer"
                target="_blank"
            >
                <Shield size={12} />
                {LINKS.police}
            </a>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: var(--color-forest);
        color: var(--color-white-70);
    }

    .footer__brand-col {
        min-width: 12.5rem;
        padding-right: clamp(0rem, calc(-0.75rem + 3.75vw), 2.25rem);
    }

    .footer__col {
        min-width: 0;
    }

    .footer__contact {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-15);
        display: flex;
        flex-wrap: wrap;
        font-size: var(--text-meta);
        gap: 0.5rem 1.625rem;
        justify-content: space-between;
        padding-block: 1.625rem;
    }

    .footer__contact-link {
        color: var(--color-white-90);
        position: relative;
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
    }

    .footer__contact-link:active {
        opacity: 0.8;
    }

    .footer__contact-link:hover {
        color: var(--color-reef);
    }

    .footer__contact-link::after {
        content: '';
        inset: -0.75rem -0.5rem;
        position: absolute;
    }

    .footer__desc {
        color: var(--color-white-70);
        font-size: var(--text-meta);
        line-height: 1.9;
        margin-bottom: 1.375rem;
        max-width: 16.25rem;
    }

    .footer__grid {
        display: grid;
        gap: 2.875rem;
        grid-template-columns: minmax(12.5rem, 1fr) repeat(4, minmax(0, 1fr)) minmax(9.375rem, 1fr);
        margin-bottom: 3rem;
    }

    .footer__heading {
        color: var(--color-white);
        font-size: var(--text-small);
        letter-spacing: 0.06em;
        margin-bottom: 1.125rem;
    }

    .footer__inner {
        padding-top: clamp(3.5rem, calc(2.92rem + 2.92vw), 5.25rem);
    }

    .footer__legal {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-10);
        color: var(--color-white-55);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-label);
        font-size: 0.75rem;
        gap: 0.375rem 1.375rem;
        letter-spacing: 0.03em;
        padding: 1.25rem 0 1.875rem;
    }

    .footer__legal a {
        color: var(--color-white-55);
        position: relative;
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
    }

    .footer__legal a:active {
        opacity: 0.8;
    }

    .footer__legal a:hover {
        color: var(--color-white);
    }

    .footer__legal a::after {
        content: '';
        inset: -0.8125rem -0.3125rem;
        position: absolute;
    }

    .footer__legal-badge {
        align-items: center;
        display: inline-flex;
        gap: 0.375rem;
    }

    .footer__link {
        color: var(--color-white-70);
        display: block;
        font-size: 0.875rem;
        padding-block: 0.5rem;
        position: relative;
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
    }

    .footer__link:active {
        opacity: 0.8;
    }

    .footer__link:hover {
        color: var(--color-white);
    }

    .footer__link::after {
        content: '';
        inset: 0 -0.75rem;
        position: absolute;
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .footer__logo {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .footer__logo:active {
        opacity: 0.8;
    }

    .footer__logo:hover .footer__logo-zh {
        color: var(--color-reef);
    }

    .footer__logo-en {
        color: var(--color-white-55);
        font-family: var(--font-label);
        font-size: 0.5625rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
    }

    .footer__logo-icon {
        align-items: center;
        background: var(--color-white);
        border-radius: var(--radius-card-sm);
        display: flex;
        height: 2.5rem;
        justify-content: center;
        width: 2.5rem;
    }

    .footer__logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

    .footer__logo-zh {
        color: var(--color-white);
        font-family: var(--font-display);
        font-size: 1.1875rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        margin-bottom: 0.25rem;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .footer__qr {
        background: var(--color-white);
        border-radius: var(--radius-card-sm);
        color: var(--color-pine);
        display: block;
        line-height: 0;
        margin-bottom: 0.875rem;
        padding: 0.5rem;
        transition: transform var(--duration-fast) var(--ease-out);
        width: fit-content;
    }

    .footer__qr:active {
        transform: translateY(0);
    }

    .footer__qr:hover {
        transform: translateY(-0.125rem);
    }

    .footer__qr-col {
        min-width: 9.375rem;
    }

    .footer__qr-label {
        color: var(--color-white-55);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
        margin-bottom: 0;
    }

    .footer__social {
        align-items: center;
        border: 0.0625rem solid var(--color-white-15);
        border-radius: 50%;
        color: var(--color-white-90);
        display: flex;
        height: 2.75rem;
        justify-content: center;
        position: relative;
        transition:
            background var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
        width: 2.75rem;
    }

    .footer__social:active {
        background: var(--color-jade-deep);
    }

    .footer__social:hover {
        background: var(--color-jade);
        border-color: var(--color-jade);
        color: var(--color-white);
    }

    .footer__social::after {
        content: '';
        inset: -0.1875rem;
        position: absolute;
    }

    .footer__social--pending {
        color: var(--color-white-55);
        cursor: not-allowed;
        opacity: 0.55;
    }

    .footer__social--pending:active,
    .footer__social--pending:hover {
        background: transparent;
        border-color: var(--color-white-15);
        color: var(--color-white-55);
    }

    .footer__socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        list-style: none;
        padding: 0;
    }

    @media (max-width: 1024px) {
        .footer__grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .footer__grid {
            grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
        }
    }
</style>
