---
import Phone from '@components/icons/Phone.astro';
import logoIcon from '@images/logos/icon.webp';
import { BRAND, LINKS, ROUTES } from '@lib/constants';

const currentPath = Astro.routePattern;

const navRoutes = ROUTES.map(route => ({
    ...route,
    children: route.children?.map(child => ({ ...child, isCurrent: currentPath === child.path })),
    isActive: route.path === '/' ? currentPath === '/' : currentPath.startsWith(route.path),
    isCurrent: currentPath === route.path && !route.children?.some(child => child.path === route.path),
}));
---

<header class="navbar z-100">
    <div class="navbar__bar">
        <nav
            class="navbar__nav shell"
            aria-label="主导航"
        >
            <a
                class="navbar__logo"
                href="/"
            >
                <img
                    class="navbar__icon"
                    alt=""
                    fetchpriority="high"
                    height={44}
                    loading="eager"
                    src={logoIcon.src}
                    width={44}
                />
                <span class="navbar__brand">
                    <span class="navbar__brand-zh">{BRAND.zh}</span>
                    <span
                        class="navbar__brand-en"
                        lang="en"
                    >
                        {BRAND.en}
                    </span>
                </span>
            </a>
            <div
                id="navbar-menu"
                class="navbar__menu"
            >
                <ul class="navbar__links">
                    {navRoutes.map(route => (
                        <li class="navbar__item">
                            <a
                                class:list={['navbar__link', { 'navbar__link--active': route.isActive }]}
                                aria-current={route.isCurrent ? 'page' : undefined}
                                href={route.path}
                            >
                                {route.label}
                            </a>
                            {route.children && (
                                <ul class="navbar__dropdown z-1">
                                    {route.children.map(child => (
                                        <li>
                                            <a
                                                class:list={['navbar__dropdown-link', { 'navbar__dropdown-link--active': child.isCurrent }]}
                                                aria-current={child.isCurrent ? 'page' : undefined}
                                                href={child.path}
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
                <a
                    class="button button--primary navbar__menu-cta"
                    href={LINKS.hotlineHref}
                >
                    <Phone size={16} />
                    {LINKS.hotline}
                </a>
            </div>
            <a
                class="navbar__cta"
                href={LINKS.hotlineHref}
            >
                <span
                    class="navbar__cta-icon"
                    aria-hidden="true"
                >
                    <Phone size={16} />
                </span>
                <span class="navbar__cta-text">
                    <span class="navbar__cta-label">{LINKS.hotlineLabel}</span>
                    <span class="navbar__cta-number">{LINKS.hotline}</span>
                </span>
            </a>
            <button
                class="navbar__toggle"
                aria-controls="navbar-menu"
                aria-expanded="false"
                aria-label="菜单"
                type="button"
            >
                <span aria-hidden="true" />
                <span aria-hidden="true" />
                <span aria-hidden="true" />
            </button>
        </nav>
    </div>
</header>

<style>
    .navbar {
        position: sticky;
        top: 0;
    }

    .navbar__bar {
        backdrop-filter: saturate(180%) blur(0.875rem);
        background: var(--color-white-90);
        box-shadow: 0 0.0625rem 0 var(--color-veil-05);
        transition: box-shadow var(--duration-base) var(--ease-out);
    }

    .navbar__brand {
        display: flex;
        flex-direction: column;
        line-height: 1;
        min-width: 0;
    }

    .navbar__brand-en {
        color: var(--color-sage);
        font-family: var(--font-label);
        font-size: 0.6rem;
        font-weight: 500;
        letter-spacing: 0.3em;
        text-transform: uppercase;
    }

    .navbar__brand-zh {
        color: var(--color-pine-light);
        font-family: var(--font-display);
        font-size: 1.3125rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        margin-bottom: 0.375rem;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .navbar__cta {
        align-items: center;
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-jade);
        color: var(--color-white);
        display: flex;
        gap: 0.75rem;
        min-width: 0;
        padding: 0.625rem 1.25rem 0.625rem 0.75rem;
        transition:
            background var(--duration-fast) var(--ease-out),
            transform var(--duration-fast) var(--ease-out);
    }

    .navbar__cta:active {
        transform: translateY(0);
    }

    .navbar__cta:hover {
        background: var(--color-jade-deep);
        transform: translateY(-0.0625rem);
    }

    .navbar__cta-icon {
        align-items: center;
        background: var(--color-white-15);
        border-radius: 50%;
        display: flex;
        flex-shrink: 0;
        height: 2rem;
        justify-content: center;
        width: 2rem;
    }

    .navbar__cta-label {
        color: var(--color-white);
        font-family: var(--font-label);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        min-width: 0;
        text-transform: uppercase;
    }

    .navbar__cta-number {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        min-width: 0;
    }

    .navbar__cta-text {
        display: flex;
        flex-direction: column;
        line-height: 1.18;
        min-width: 0;
    }

    .navbar__dropdown {
        background: var(--color-white);
        border: var(--border-soft);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-panel);
        left: 0;
        list-style: none;
        margin: 0;
        opacity: 0;
        padding: 0.625rem;
        pointer-events: none;
        position: absolute;
        top: calc(100% + 0.75rem);
        transform: translateY(0.75rem);
        transition:
            opacity var(--duration-fast) var(--ease-out),
            transform var(--duration-fast) var(--ease-out),
            visibility var(--duration-fast);
        visibility: hidden;
        width: 14.375rem;
    }

    .navbar__dropdown::before {
        content: '';
        height: 0.75rem;
        left: 0;
        position: absolute;
        right: 0;
        top: -0.75rem;
    }

    .navbar__dropdown-link {
        border-radius: var(--radius-card-sm);
        color: var(--color-sage-dark);
        display: block;
        font-size: 0.875rem;
        padding: 0.75rem 0.875rem;
        transition:
            background var(--duration-fast) var(--ease-out),
            color var(--duration-fast) var(--ease-out);
    }

    .navbar__dropdown-link:active {
        background: var(--color-stone);
    }

    .navbar__dropdown-link:hover,
    .navbar__dropdown-link--active {
        background: var(--color-mint);
        color: var(--color-jade);
    }

    .navbar__icon {
        display: block;
        height: 2.75rem;
        width: auto;
    }

    .navbar__item {
        position: relative;
    }

    .navbar__item:focus-within .navbar__dropdown,
    .navbar__item:hover .navbar__dropdown {
        opacity: 1;
        pointer-events: auto;
        transform: none;
        visibility: visible;
    }

    .navbar__item:last-child .navbar__dropdown {
        left: auto;
        right: 0;
    }

    .navbar__link {
        color: var(--color-moss);
        display: block;
        flex-shrink: 0;
        padding: 0.5rem 0.75rem;
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
        white-space: nowrap;
    }

    .navbar__link:active {
        opacity: 0.8;
    }

    .navbar__link:hover,
    .navbar__link--active {
        color: var(--color-jade);
    }

    .navbar__links {
        align-items: center;
        display: flex;
        font-size: var(--text-small);
        font-weight: 500;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .navbar__logo {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        min-width: 0;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .navbar__logo:active {
        opacity: 0.8;
    }

    .navbar__logo:hover .navbar__brand-zh {
        color: var(--color-jade);
    }

    .navbar__menu-cta {
        display: none;
    }

    .navbar__nav {
        align-items: center;
        display: flex;
        gap: 1.25rem;
        height: var(--spacing-header);
        justify-content: space-between;
    }

    .navbar__toggle {
        align-items: center;
        background: var(--color-mint);
        border: none;
        border-radius: var(--radius-card-sm);
        display: none;
        flex-direction: column;
        gap: 0.375rem;
        height: 2.875rem;
        justify-content: center;
        position: relative;
        transition: background var(--duration-fast) var(--ease-out);
        user-select: none;
        width: 2.875rem;
    }

    .navbar__toggle:active {
        background: var(--color-sand);
    }

    .navbar__toggle:hover {
        background: var(--color-laurel);
    }

    .navbar__toggle::after {
        content: '';
        inset: -0.0625rem;
        position: absolute;
    }

    .navbar__toggle span {
        background: var(--color-pine-light);
        border-radius: 0.125rem;
        height: 0.125rem;
        transition:
            opacity var(--duration-fast) var(--ease-out),
            transform var(--duration-base) var(--ease-out);
        width: 1.25rem;
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(1) {
        transform: translateY(0.5rem) rotate(45deg);
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(2) {
        opacity: 0;
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(3) {
        transform: translateY(-0.5rem) rotate(-45deg);
    }

    [data-scrolled] .navbar__bar {
        box-shadow: 0 0.625rem 2.125rem var(--color-veil-10);
    }

    @media (max-width: 1024px) {
        .navbar__cta {
            display: none;
        }

        .navbar__dropdown {
            background: transparent;
            border: none;
            box-shadow: none;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            opacity: 1;
            padding: 0;
            pointer-events: auto;
            position: static;
            transform: none;
            visibility: inherit;
            width: auto;
        }

        .navbar__dropdown-link {
            background: var(--color-mint);
            border-radius: var(--radius-pill);
            padding: 0.625rem 0.875rem;
        }

        .navbar__item {
            border-bottom: 0.0625rem solid var(--color-snow);
            padding-block: 1rem;
        }

        .navbar__item:has(.navbar__dropdown) .navbar__link {
            margin-bottom: 0.75rem;
        }

        .navbar__link {
            font-family: var(--font-display);
            font-size: 1.1875rem;
            font-weight: 700;
            padding-inline: 0;
        }

        .navbar__links {
            align-items: stretch;
            flex-direction: column;
            font-size: 1rem;
            gap: 0;
            margin-bottom: 1.375rem;
        }

        .navbar__menu {
            background: var(--color-white);
            border-bottom: var(--border-soft);
            inset: var(--spacing-header) 0 auto;
            max-height: calc(100svh - var(--spacing-header));
            opacity: 0;
            overflow-y: auto;
            padding: 0.5rem var(--gutter) 2.5rem;
            position: fixed;
            transition:
                opacity var(--duration-fast) var(--ease-out),
                visibility 0s var(--duration-fast);
            visibility: hidden;
        }

        .navbar__menu--open {
            opacity: 1;
            transition:
                opacity var(--duration-fast) var(--ease-out),
                visibility 0s;
            visibility: visible;
        }

        .navbar__menu--static {
            transition: none;
        }

        .navbar__menu-cta {
            display: inline-flex;
            width: 100%;
        }

        .navbar__toggle {
            display: flex;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .navbar__menu,
        .navbar__menu * {
            transition: none;
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/utils';
    import { watchScrolled } from '@lib/motion';

    const BEHIND_SELECTOR = 'main, footer, .editor-panel, .editor-controls';
    const MOBILE_QUERY = '(max-width: 1024px)';
    const OPEN_CLASS = 'navbar__menu--open';

    const mobileQuery = window.matchMedia(MOBILE_QUERY);

    let menu: HTMLElement | null = null;
    let toggle: HTMLElement | null = null;

    function getFocusables() {
        const nodes = document.querySelectorAll<HTMLElement>('.navbar a[href], .navbar button:not(:disabled)');

        return Array.from(nodes).filter(node => node.getClientRects().length > 0);
    }

    function handleBreakpointChange(event: MediaQueryListEvent) {
        if (!event.matches) setMenuOpen(false);

        suppressTransition();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (!menu?.classList.contains(OPEN_CLASS)) return;

        if (event.key === 'Escape') {
            setMenuOpen(false);
            toggle?.focus();

            return;
        }

        if (event.key !== 'Tab' || !isMobile()) return;

        const focusables = getFocusables();

        const first = focusables[0];
        const index = focusables.findIndex(node => node === document.activeElement);
        const last = focusables.at(-1);

        if (!first || !last) return;

        if (event.shiftKey && index <= 0) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && (index === -1 || index === focusables.length - 1)) {
            event.preventDefault();
            first.focus();
        }
    }

    function handleScrolledChange(isScrolled: boolean) {
        document.querySelector('.navbar')?.toggleAttribute('data-scrolled', isScrolled);
    }

    function initNavbar(signal: AbortSignal) {
        menu = document.querySelector<HTMLElement>('.navbar__menu');
        toggle = document.querySelector<HTMLElement>('.navbar__toggle');

        if (!menu || !toggle) return;

        menu.addEventListener('click', (event) => {
            if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
        }, { signal });

        toggle.addEventListener('click', () => setMenuOpen(toggle?.getAttribute('aria-expanded') !== 'true'), { signal });
    }

    function isMobile() {
        return mobileQuery.matches;
    }

    function setBehindInert(isInert: boolean) {
        document.querySelectorAll<HTMLElement>(BEHIND_SELECTOR).forEach(node => node.toggleAttribute('inert', isInert));
    }

    function setMenuOpen(isOpen: boolean) {
        if (!menu || !toggle) return;

        const isModal = isMobile() && isOpen;

        menu.classList.toggle(OPEN_CLASS, isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
        setBehindInert(isModal);

        if (isModal) menu.querySelector<HTMLElement>('a')?.focus();
    }

    function suppressTransition() {
        if (!menu) return;

        menu.classList.add('navbar__menu--static');
        requestAnimationFrame(() => requestAnimationFrame(() => menu?.classList.remove('navbar__menu--static')));
    }

    document.addEventListener('keydown', handleKeydown);
    mobileQuery.addEventListener('change', handleBreakpointChange);
    registerPageScript(initNavbar);
    watchScrolled(handleScrolledChange);
</script>
