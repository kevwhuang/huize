---
import Globe from '@components/icons/Globe.astro';
import MapPin from '@components/icons/MapPin.astro';
import Phone from '@components/icons/Phone.astro';
import Qr from '@components/Qr.astro';
import { LINKS } from '@lib/constants';
import { getEditId, getSection, getServices } from '@lib/database';

const OTHER_TYPE = '其他';

const contactPanel = await getSection('contact-panel');
const services = await getServices();

const captionLines = (contactPanel.caption ?? '').split('\n');
const [notePrefix, noteSuffix] = contactPanel.paragraphs ?? [];
const serviceTypes = [...services.map(service => service.data.label), OTHER_TYPE];
---

<section
    class="contact-panel section"
    aria-labelledby="contact-panel-title"
>
    <div class="shell">
        <div class="contact-panel__grid">
            <div data-scroll="left">
                <h2
                    id="contact-panel-title"
                    class="sr-only"
                >
                    咨询表单
                </h2>
                <form
                    class="card contact-panel__form"
                    novalidate
                >
                    <div class="contact-panel__row">
                        <label class="contact-panel__field">
                            <span>
                                姓名
                                <span
                                    class="contact-panel__required"
                                    aria-hidden="true"
                                >
                                    *
                                </span>
                            </span>
                            <input
                                autocomplete="name"
                                name="name"
                                placeholder="请输入您的姓名"
                                required
                                type="text"
                            />
                        </label>
                        <label class="contact-panel__field">
                            <span>
                                电话
                                <span
                                    class="contact-panel__required"
                                    aria-hidden="true"
                                >
                                    *
                                </span>
                            </span>
                            <input
                                autocomplete="tel"
                                inputmode="tel"
                                name="phone"
                                pattern="[0-9\-\s+]{6,}"
                                placeholder="请输入您的联系电话"
                                required
                                type="tel"
                            />
                        </label>
                    </div>
                    <label class="contact-panel__field">
                        <span>服务类型</span>
                        <select name="type">
                            <option value="">请选择服务类型</option>
                            {serviceTypes.map(type => (
                                <option value={type}>{type}</option>
                            ))}
                        </select>
                    </label>
                    <label class="contact-panel__field">
                        <span>留言</span>
                        <textarea
                            name="message"
                            placeholder="请描述您的具体需求"
                            rows="4"
                        />
                    </label>
                    <button
                        class="button button--large button--primary"
                        aria-describedby="contact-panel-note"
                        disabled
                        type="submit"
                    >
                        立即咨询
                    </button>
                    <p
                        id="contact-panel-note"
                        class="contact-panel__note"
                    >
                        <span
                            data-edit="sections/contact-panel.paragraphs.0"
                            data-edit-id={getEditId('sections/contact-panel.paragraphs.0')}
                        >
                            {notePrefix}
                        </span>
                        <a href={LINKS.hotlineHref}>{LINKS.hotline}</a>
                        <span
                            data-edit="sections/contact-panel.paragraphs.1"
                            data-edit-id={getEditId('sections/contact-panel.paragraphs.1')}
                        >
                            {noteSuffix}
                        </span>
                    </p>
                </form>
            </div>
            <div
                class="contact-panel__aside"
                data-scroll="right"
            >
                <h2>{contactPanel.heading}</h2>
                <p
                    class="contact-panel__lead"
                    data-edit="sections/contact-panel.lead"
                    data-edit-id={getEditId('sections/contact-panel.lead')}
                >
                    {contactPanel.lead}
                </p>
                <dl class="contact-panel__details">
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <Phone size={20} />
                            </span>
                            {LINKS.hotlineLabel}
                        </dt>
                        <dd><a href={LINKS.hotlineHref}>{LINKS.hotline}</a></dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <Phone size={20} />
                            </span>
                            {LINKS.shanghaiLabel}
                        </dt>
                        <dd><a href={LINKS.shanghaiHref}>{LINKS.shanghai}</a></dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <MapPin size={20} />
                            </span>
                            公司地址
                        </dt>
                        <dd>{LINKS.address}</dd>
                    </div>
                    <div class="contact-panel__detail">
                        <dt class="label label--on-dark">
                            <span aria-hidden="true">
                                <Globe size={20} />
                            </span>
                            公司网址
                        </dt>
                        <dd>{LINKS.website}</dd>
                    </div>
                </dl>
                <div class="contact-panel__qr">
                    <a
                        class="contact-panel__qr-frame"
                        aria-label="关注惠泽健康微信公众号"
                        href={LINKS.wechat}
                        rel="noopener noreferrer"
                        target="_blank"
                    >
                        <Qr size={96} />
                    </a>
                    <p
                        data-edit="sections/contact-panel.caption"
                        data-edit-id={getEditId('sections/contact-panel.caption')}
                    >
                        {captionLines.map((line, index) => (index > 0 ? <Fragment><br />{line}</Fragment> : line))}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-panel__aside {
        --heading-color: var(--color-white);
        background: var(--color-pine);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-panel);
        color: var(--color-white-70);
        padding: var(--pad-panel);
    }

    .contact-panel__aside h2 {
        font-size: var(--text-h3);
    }

    .contact-panel__detail {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        justify-content: space-between;
    }

    .contact-panel__detail a {
        color: var(--color-white);
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
    }

    .contact-panel__detail a:active {
        opacity: 0.8;
    }

    .contact-panel__detail a:hover {
        color: var(--color-reef);
    }

    .contact-panel__details {
        display: grid;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .contact-panel__details dd {
        color: var(--color-white-90);
        font-size: var(--text-small);
        line-height: 1.6;
        margin-bottom: 0;
        text-align: right;
    }

    .contact-panel__details dt {
        align-items: center;
        display: flex;
        gap: 0.625rem;
        margin-bottom: 0;
    }

    .contact-panel__field {
        display: grid;
        gap: 0.5rem;
    }

    .contact-panel__field > span {
        color: var(--color-sage-dark);
        font-size: var(--text-meta);
        font-weight: 500;
    }

    .contact-panel__field :is(input, select, textarea) {
        background: var(--color-cloud);
        border: 0.0625rem solid var(--color-stone);
        border-radius: var(--radius-card-sm);
        color: var(--color-cedar);
        font: inherit;
        padding: 0.875rem 1rem;
        transition:
            background var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            box-shadow var(--duration-fast) var(--ease-out);
        width: 100%;
    }

    .contact-panel__field :is(input, select, textarea):focus-visible {
        background: var(--color-white);
        border-color: var(--color-jade);
        box-shadow: 0 0 0 0.1875rem var(--color-jade-20);
        outline: none;
    }

    .contact-panel__field :is(input, select, textarea):hover:not(:focus-visible) {
        border-color: var(--color-sand);
    }

    .contact-panel__field textarea {
        resize: vertical;
    }

    .contact-panel__form {
        display: grid;
        gap: 1.125rem;
    }

    .contact-panel__grid {
        align-items: start;
        display: grid;
        gap: clamp(2rem, calc(1.5rem + 2.5vw), 3.5rem);
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }

    .contact-panel__lead {
        color: var(--color-white-70);
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.8;
        margin-bottom: 2.125rem;
    }

    .contact-panel__note {
        color: var(--color-sage);
        font-size: var(--text-meta);
        margin-bottom: 0;
        text-align: center;
    }

    .contact-panel__note a {
        color: var(--color-jade);
        font-weight: 500;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .contact-panel__note a:active {
        opacity: 0.8;
    }

    .contact-panel__note a:hover {
        text-decoration: underline;
    }

    .contact-panel__qr {
        align-items: center;
        border-top: 0.0625rem solid var(--color-white-15);
        color: var(--color-white-70);
        display: flex;
        font-size: var(--text-meta);
        gap: 1rem;
        padding-top: 1.75rem;
    }

    .contact-panel__qr p {
        margin-bottom: 0;
    }

    .contact-panel__qr-frame {
        background: var(--color-white);
        border-radius: var(--radius-card-sm);
        color: var(--color-pine);
        display: block;
        flex-shrink: 0;
        line-height: 0;
        padding: 0.5rem;
        transition: transform var(--duration-fast) var(--ease-out);
    }

    .contact-panel__qr-frame:active {
        transform: translateY(0);
    }

    .contact-panel__qr-frame:hover {
        transform: translateY(-0.125rem);
    }

    .contact-panel__required {
        color: var(--color-coral);
    }

    .contact-panel__row {
        display: grid;
        gap: 1.125rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (max-width: 1024px) {
        .contact-panel__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 768px) {
        .contact-panel__row {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    import { registerPageScript } from '@lib/utils';

    function initContactPanel(signal: AbortSignal) {
        const form = document.querySelector<HTMLFormElement>('.contact-panel__form');

        form?.addEventListener('submit', event => event.preventDefault(), { signal });
    }

    registerPageScript(initContactPanel);
</script>
