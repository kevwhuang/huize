---
import IconPhone from '@components/IconPhone.astro';
import logoIcon from '@images/logo_icon.webp';
import { LINKS, ROUTES } from '@lib/constants';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="navbar">
    <div class="navbar__bar">
        <nav
            class="navbar__nav shell"
            aria-label="主导航"
        >
            <a
                class="navbar__logo"
                href="/"
            >
                <img
                    class="navbar__icon"
                    alt=""
                    fetchpriority="high"
                    height={44}
                    loading="eager"
                    src={logoIcon.src}
                    width={44}
                />
                <span class="navbar__brand">
                    <span class="navbar__brand-zh">惠泽健康</span>
                    <span
                        class="navbar__brand-en"
                        lang="en"
                    >
                        Huize Health
                    </span>
                </span>
            </a>

            <div
                id="navbar-menu"
                class="navbar__menu"
            >
                <ul class="navbar__links">
                    {ROUTES.map(route => (
                        <li class="navbar__item">
                            <a
                                class:list={['navbar__link', { 'navbar__link--active': route.path === '/' ? currentPath === '/' : currentPath.startsWith(route.path) }]}
                                aria-current={currentPath === route.path ? 'page' : undefined}
                                href={route.path}
                            >
                                {route.label}
                            </a>
                            {route.children && (
                                <ul class="navbar__dropdown">
                                    {route.children.map(child => (
                                        <li>
                                            <a
                                                class:list={['navbar__dropdown-link', { 'navbar__dropdown-link--active': currentPath === child.path }]}
                                                aria-current={currentPath === child.path ? 'page' : undefined}
                                                href={child.path}
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
                <a
                    class="navbar__menu-cta button button--primary"
                    href={LINKS.hotlineHref}
                >
                    <IconPhone size={17} />
                    {LINKS.hotline}
                </a>
            </div>

            <a
                class="navbar__cta"
                href={LINKS.hotlineHref}
            >
                <span
                    class="navbar__cta-icon"
                    aria-hidden="true"
                >
                    <IconPhone size={16} />
                </span>
                <span class="navbar__cta-text">
                    <span class="navbar__cta-label">全国服务热线</span>
                    <span class="navbar__cta-number">{LINKS.hotline}</span>
                </span>
            </a>

            <button
                class="navbar__toggle"
                aria-controls="navbar-menu"
                aria-expanded="false"
                aria-label="菜单"
                type="button"
            >
                <span aria-hidden="true" />
                <span aria-hidden="true" />
                <span aria-hidden="true" />
            </button>
        </nav>
    </div>
</header>

<style>
    .navbar {
        position: sticky;
        top: 0;
        z-index: 60;
    }

    .navbar__bar {
        backdrop-filter: saturate(180%) blur(0.875rem);
        background: var(--color-white-90);
        box-shadow: 0 0.0625rem 0 var(--color-veil-06);
        transition: box-shadow var(--duration-base) var(--ease-out);
    }

    .navbar__brand {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

    .navbar__brand-en {
        color: var(--color-sage);
        font-family: var(--font-label);
        font-size: 0.6rem;
        font-weight: 500;
        letter-spacing: 0.3em;
        margin-top: 0.3125rem;
        text-transform: uppercase;
    }

    .navbar__brand-zh {
        color: var(--color-pine-light);
        font-family: var(--font-display);
        font-size: 1.3125rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .navbar__cta {
        align-items: center;
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-jade);
        color: #FFFFFF;
        display: flex;
        flex-shrink: 0;
        gap: 0.6875rem;
        padding: 0.5625rem 1.25rem 0.5625rem 0.6875rem;
        transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    }

    .navbar__cta:active {
        transform: translateY(0);
    }

    .navbar__cta:hover {
        background: var(--color-jade-deep);
        transform: translateY(-0.0625rem);
    }

    .navbar__cta-icon {
        align-items: center;
        background: var(--color-white-12);
        border-radius: 50%;
        display: flex;
        flex-shrink: 0;
        height: 2rem;
        justify-content: center;
        width: 2rem;
    }

    .navbar__cta-label {
        color: #FFFFFF;
        font-family: var(--font-label);
        font-size: 0.6rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .navbar__cta-number {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .navbar__cta-text {
        display: flex;
        flex-direction: column;
        line-height: 1.18;
    }

    .navbar__dropdown {
        background: #FFFFFF;
        border: 0.0625rem solid var(--color-silk);
        border-radius: var(--radius-card-sm);
        box-shadow: var(--shadow-panel);
        left: 0;
        list-style: none;
        margin: 0;
        opacity: 0;
        padding: 0.625rem;
        pointer-events: none;
        position: absolute;
        top: calc(100% + 0.75rem);
        transform: translateY(0.75rem);
        transition:
            opacity var(--duration-fast) var(--ease-out),
            transform var(--duration-fast) var(--ease-out),
            visibility var(--duration-fast);
        visibility: hidden;
        width: 14.375rem;
        z-index: 1;
    }

    .navbar__dropdown::before {
        content: '';
        height: 0.75rem;
        left: 0;
        position: absolute;
        right: 0;
        top: -0.75rem;
    }

    .navbar__dropdown-link {
        border-radius: var(--radius-card-sm);
        color: var(--color-sage-dark);
        display: block;
        font-size: 0.9rem;
        padding: 0.6875rem 0.875rem;
        transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }

    .navbar__dropdown-link:active {
        background: var(--color-stone);
    }

    .navbar__dropdown-link:hover,
    .navbar__dropdown-link--active {
        background: var(--color-mint);
        color: var(--color-jade);
    }

    .navbar__icon {
        display: block;
        height: 2.75rem;
        width: auto;
    }

    .navbar__item {
        position: relative;
    }

    .navbar__item:focus-within .navbar__dropdown,
    .navbar__item:hover .navbar__dropdown {
        opacity: 1;
        pointer-events: auto;
        transform: none;
        visibility: visible;
    }

    .navbar__item:last-child .navbar__dropdown {
        left: auto;
        right: 0;
    }

    .navbar__link {
        color: var(--color-moss);
        display: block;
        flex-shrink: 0;
        padding: 0.5rem 0.75rem;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
        white-space: nowrap;
    }

    .navbar__link:active {
        opacity: 0.8;
    }

    .navbar__link:hover,
    .navbar__link--active {
        color: var(--color-jade);
    }

    .navbar__links {
        align-items: center;
        display: flex;
        font-size: 0.97rem;
        font-weight: 500;
        gap: 0.4375rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .navbar__logo {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.8125rem;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .navbar__logo:active {
        opacity: 0.8;
    }

    .navbar__logo:hover .navbar__brand-zh {
        color: var(--color-jade);
    }

    .navbar__menu-cta {
        display: none;
    }

    .navbar__nav {
        align-items: center;
        display: flex;
        gap: 1.25rem;
        height: var(--spacing-header);
        justify-content: space-between;
    }

    .navbar__toggle {
        align-items: center;
        background: var(--color-mint);
        border: none;
        border-radius: var(--radius-card-sm);
        display: none;
        flex-direction: column;
        gap: 0.3125rem;
        height: 2.875rem;
        justify-content: center;
        transition: background var(--duration-fast) var(--ease-out);
        width: 2.875rem;
    }

    .navbar__toggle:active {
        background: var(--color-sand);
    }

    .navbar__toggle:hover {
        background: var(--color-laurel);
    }

    .navbar__toggle span {
        background: var(--color-pine-light);
        border-radius: 0.125rem;
        height: 0.125rem;
        transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-base) var(--ease-out);
        width: 1.1875rem;
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(1) {
        transform: translateY(0.4375rem) rotate(45deg);
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(2) {
        opacity: 0;
    }

    .navbar__toggle[aria-expanded='true'] span:nth-child(3) {
        transform: translateY(-0.4375rem) rotate(-45deg);
    }

    [data-scrolled] .navbar__bar {
        box-shadow: 0 0.625rem 2.125rem var(--color-veil-10);
    }

    @media (max-width: 1024px) {
        .navbar__cta {
            display: none;
        }

        .navbar__dropdown {
            background: transparent;
            border: none;
            box-shadow: none;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.75rem;
            opacity: 1;
            padding: 0;
            pointer-events: auto;
            position: static;
            transform: none;
            visibility: inherit;
            width: auto;
        }

        .navbar__dropdown-link {
            background: var(--color-mint);
            border-radius: var(--radius-pill);
            font-size: 0.875rem;
            padding: 0.625rem 0.875rem;
        }

        .navbar__item {
            border-bottom: 0.0625rem solid var(--color-snow);
            padding-block: 1rem;
        }

        .navbar__link {
            font-family: var(--font-display);
            font-size: 1.1875rem;
            font-weight: 700;
            padding-inline: 0;
        }

        .navbar__links {
            align-items: stretch;
            flex-direction: column;
            font-size: 1rem;
            gap: 0;
        }

        .navbar__menu {
            background: #FFFFFF;
            border-bottom: 0.0625rem solid var(--color-silk);
            inset: var(--spacing-header) 0 auto;
            max-height: calc(100svh - var(--spacing-header));
            overflow-y: auto;
            padding: 0.5rem var(--gutter) 2.5rem;
            position: fixed;
            transform: translateY(-101%);
            transition: transform var(--duration-base) var(--ease-out), visibility 0s var(--duration-base);
            visibility: hidden;
        }

        .navbar__menu--open {
            transform: translateY(0);
            transition: transform var(--duration-base) var(--ease-out), visibility 0s;
            visibility: visible;
        }

        .navbar__menu--static {
            transition: none;
        }

        .navbar__menu-cta {
            display: inline-flex;
            margin-top: 1.375rem;
            width: 100%;
        }

        .navbar__toggle {
            display: flex;
        }
    }
</style>

<script>
    import { watchScrolled } from '@lib/motion';
    import { registerPageScript } from '@lib/utils';

    const MOBILE_QUERY = '(max-width: 1024px)';
    const OPEN_CLASS = 'navbar__menu--open';

    let menu: HTMLElement | null = null;
    let toggle: HTMLElement | null = null;

    function handleBreakpointChange(event: MediaQueryListEvent) {
        if (!event.matches) setMenuOpen(false);

        suppressTransition();
    }

    function handleKeydown(event: KeyboardEvent) {
        if (event.key !== 'Escape' || !menu?.classList.contains(OPEN_CLASS)) return;

        setMenuOpen(false);
        toggle?.focus();
    }

    function handleScrolledChange(isScrolled: boolean) {
        document.querySelector('.navbar')?.toggleAttribute('data-scrolled', isScrolled);
    }

    function initNavbar(signal: AbortSignal) {
        menu = document.getElementById('navbar-menu');
        toggle = document.querySelector<HTMLElement>('.navbar__toggle');

        if (!menu || !toggle) return;

        menu.addEventListener('click', (event) => {
            if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
        }, { signal });

        toggle.addEventListener('click', () => setMenuOpen(toggle?.getAttribute('aria-expanded') !== 'true'), { signal });
    }

    function isMobile() {
        return window.matchMedia(MOBILE_QUERY).matches;
    }

    function setMenuOpen(isOpen: boolean) {
        if (!menu || !toggle) return;

        menu.classList.toggle(OPEN_CLASS, isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));

        if (isOpen && isMobile()) menu.querySelector<HTMLElement>('a')?.focus();
    }

    function suppressTransition() {
        if (!menu) return;

        menu.classList.add('navbar__menu--static');
        requestAnimationFrame(() => requestAnimationFrame(() => menu?.classList.remove('navbar__menu--static')));
    }

    document.addEventListener('keydown', handleKeydown);
    registerPageScript(initNavbar);
    watchScrolled(handleScrolledChange);
    window.matchMedia(MOBILE_QUERY).addEventListener('change', handleBreakpointChange);
</script>
