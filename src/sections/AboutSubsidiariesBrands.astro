---
import IconMapPin from '@components/IconMapPin.astro';
import SectionHead from '@components/SectionHead.astro';
import { OWNED_INSTITUTIONS } from '@lib/constants';

const BRANDS = [
    {
        blurb: '重庆区域的老年护养中心与护理院网络，覆盖沙坪坝、大渡口、江北、渝中、璧山与两江新区。',
        name: '合展',
        region: '重庆',
    },
    {
        blurb: '以浙江为核心，延伸至江苏、广东与江西的医院、护理院、康复医院与社区家园，并设有介护职业培训学校与老年科学技术研究所。',
        name: '绿康',
        region: '浙江 · 江苏 · 广东 · 江西',
    },
];

const groups = BRANDS.map(brand => ({
    ...brand,
    institutions: OWNED_INSTITUTIONS.filter(institution => institution.brand === brand.name),
}));
---

<section
    class="about-subsidiaries section"
    aria-labelledby="about-subsidiaries-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Our Institutions"
            headingId="about-subsidiaries-title"
        >
            旗下{OWNED_INSTITUTIONS.length}家实体机构
            <Fragment slot="text">
                <p>从2012年起，创始团队在全国各地运营管理实体医疗机构、康复机构和养老连锁机构，总床位15000张，分布在18个城市。</p>
            </Fragment>
        </SectionHead>

        {groups.map(group => (
            <div class="about-subsidiaries__group">
                <div data-scroll="up">
                    <div class="about-subsidiaries__head">
                        <h3 class="about-subsidiaries__brand">{group.name}</h3>
                        <p class="about-subsidiaries__count label label--gold">{group.institutions.length} 家</p>
                        <p class="about-subsidiaries__region">{group.region}</p>
                    </div>
                    <p class="about-subsidiaries__blurb">{group.blurb}</p>
                </div>
                <ul
                    class="about-subsidiaries__list"
                    data-scroll="up"
                    data-scroll-stagger="0.06"
                >
                    {group.institutions.map(institution => (
                        <li class="about-subsidiaries__item">
                            <p class="about-subsidiaries__name">{institution.name}</p>
                            <p class="about-subsidiaries__address">
                                <span
                                    class="about-subsidiaries__pin"
                                    aria-hidden="true"
                                >
                                    <IconMapPin size={13} />
                                </span>
                                {institution.address}
                            </p>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
</section>

<style>
    .about-subsidiaries__address {
        align-items: start;
        color: var(--color-sage);
        display: flex;
        font-size: 0.8125rem;
        gap: 0.4375rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .about-subsidiaries__blurb {
        color: var(--color-sage);
        font-size: 0.9rem;
        line-height: 1.9;
        margin-bottom: 0;
        max-width: var(--measure-prose);
    }

    .about-subsidiaries__brand {
        font-size: var(--text-h2);
        margin-bottom: 0.25rem;
    }

    .about-subsidiaries__count {
        margin-bottom: 0.375rem;
    }

    .about-subsidiaries__group {
        margin-bottom: clamp(3rem, calc(2.33rem + 3.33vw), 4.5rem);
    }

    .about-subsidiaries__head {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin-bottom: clamp(1.5rem, calc(1.29rem + 1.04vw), 2rem);
    }

    .about-subsidiaries__group:last-child {
        margin-bottom: 0;
    }

    .about-subsidiaries__item {
        background: #FFFFFF;
        border: var(--border-soft);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        padding: 1.125rem 1.25rem;
        transition: border-color var(--duration-fast) var(--ease-out);
    }

    .about-subsidiaries__item:hover {
        border-color: var(--color-laurel);
    }

    .about-subsidiaries__list {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .about-subsidiaries__name {
        color: var(--color-pine);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.6;
        margin-bottom: 0.625rem;
    }

    .about-subsidiaries__pin {
        color: var(--color-jade);
        flex-shrink: 0;
        margin-top: 0.25rem;
    }

    .about-subsidiaries__region {
        color: var(--color-sage-dark);
        font-size: 0.84rem;
        margin-bottom: 0.875rem;
    }

</style>
