---
import { ROUTES } from '@lib/constants';

interface Props {
    eyebrow: string;
    title: string;
}

const { eyebrow, title } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const parent = ROUTES.find(route => route.path !== '/' && currentPath.startsWith(route.path) && route.path !== currentPath);
---

<section
    class="page-hero"
    aria-labelledby="page-hero-title"
>
    <div
        class="glow page-hero__glow"
        aria-hidden="true"
    />
    <div class="page-hero__inner shell">
        <div data-scroll="up" data-scroll-stagger>
            <p
                class="eyebrow eyebrow--on-dark"
                lang="en"
            >
                {eyebrow}
            </p>
            <h1 id="page-hero-title">{title}</h1>
            <nav
                class="page-hero__breadcrumb"
                aria-label="面包屑导航"
            >
                <ol>
                    <li><a href="/">首页</a></li>
                    {parent && <li><a href={parent.path}>{parent.label}</a></li>}
                    <li><span aria-current="page">{title}</span></li>
                </ol>
            </nav>
            <slot />
        </div>
    </div>
</section>

<style>
    .page-hero {
        --heading-color: #FFFFFF;
        background: var(--color-pine);
        overflow: clip;
        position: relative;
    }

    .page-hero h1 {
        margin-bottom: 1rem;
    }

    .page-hero__breadcrumb {
        color: var(--color-white-70);
        font-size: 0.84rem;
    }

    .page-hero__breadcrumb a {
        color: var(--color-white-70);
        position: relative;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
    }

    .page-hero__breadcrumb a::after {
        content: '';
        inset: -0.75rem -0.5rem;
        position: absolute;
    }

    .page-hero__breadcrumb a:active {
        opacity: 0.8;
    }

    .page-hero__breadcrumb a:hover {
        color: #FFFFFF;
    }

    .page-hero__breadcrumb li {
        align-items: center;
        display: flex;
        gap: 0.625rem;
    }

    .page-hero__breadcrumb li + li::before {
        color: var(--color-white-55);
        content: '/';
        content: '/' / '';
    }

    .page-hero__breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .page-hero__breadcrumb [aria-current] {
        color: var(--color-gold-light);
    }

    .page-hero__glow {
        right: -5rem;
        top: -6.25rem;
    }

    .page-hero__inner {
        padding-block: clamp(3.5rem, calc(2.5rem + 5vw), 6rem);
        position: relative;
    }
</style>
