---
import SectionHead from '@components/SectionHead.astro';
import { LINKS } from '@lib/constants';
import { getEditId, getSection } from '@lib/database';

const { eyebrow = '', groups, heading, lead, paragraphs = [] } = await getSection('services-premium-formulary');

const lists = groups?.lists ?? [];
---

<section
    class="section section--tint services-premium-formulary"
    aria-labelledby="services-premium-formulary-title"
>
    <div class="shell">
        <SectionHead
            editKey="sections/services-premium-formulary.heading"
            eyebrow={eyebrow}
            headingId="services-premium-formulary-title"
            isCentered
        >
            {heading}
            <Fragment slot="text">
                <p
                    data-edit="sections/services-premium-formulary.lead"
                    data-edit-id={getEditId('sections/services-premium-formulary.lead')}
                >
                    {lead}
                </p>
            </Fragment>
        </SectionHead>
        <ul class="services-premium-formulary__lists">
            {lists.map((list, index) => (
                <li data-scroll={index === 0 ? 'left' : 'right'}>
                    <article class="services-premium-formulary__panel">
                        <p class="services-premium-formulary__meta">
                            <span
                                class="numeral"
                                data-edit={`sections/services-premium-formulary.groups.lists.${index}.number`}
                                data-edit-id={getEditId(`sections/services-premium-formulary.groups.lists.${index}.number`)}
                            >
                                {list.number}
                            </span>
                            <span
                                class="label label--gold"
                                lang="en"
                            >
                                {list.english}
                            </span>
                        </p>
                        <p class="services-premium-formulary__count stat">
                            <span
                                data-edit={`sections/services-premium-formulary.groups.lists.${index}.value`}
                                data-edit-id={getEditId(`sections/services-premium-formulary.groups.lists.${index}.value`)}
                            >
                                {list.value}
                            </span>
                            <span
                                class="services-premium-formulary__unit"
                                data-edit={`sections/services-premium-formulary.groups.lists.${index}.suffix`}
                                data-edit-id={getEditId(`sections/services-premium-formulary.groups.lists.${index}.suffix`)}
                            >
                                {list.suffix}
                            </span>
                        </p>
                        <h3>{list.title}</h3>
                        <p
                            class="services-premium-formulary__note"
                            data-edit={`sections/services-premium-formulary.groups.lists.${index}.note`}
                            data-edit-id={getEditId(`sections/services-premium-formulary.groups.lists.${index}.note`)}
                        >
                            {list.note}
                        </p>
                    </article>
                </li>
            ))}
        </ul>
        <p
            class="services-premium-formulary__hotline"
            data-scroll
        >
            {paragraphs[0]}
            <a href={LINKS.hotlineHref}>{LINKS.hotline}</a>
            {paragraphs[1]}
        </p>
    </div>
</section>

<style>
    .services-premium-formulary__count {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        font-size: clamp(3rem, calc(2.17rem + 4.17vw), 5.5rem);
        gap: 0.1em;
        margin-bottom: 0.75rem;
    }

    .services-premium-formulary__hotline {
        color: var(--color-sage);
        margin-bottom: 0;
        margin-inline: auto;
        max-width: var(--measure-prose);
        text-align: center;
    }

    .services-premium-formulary__hotline a {
        color: var(--color-jade);
        display: inline-block;
        font-weight: 500;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        transition:
            color var(--duration-fast) var(--ease-out),
            opacity var(--duration-fast) var(--ease-out);
        vertical-align: bottom;
        white-space: nowrap;
    }

    .services-premium-formulary__hotline a:active {
        opacity: 0.8;
    }

    .services-premium-formulary__hotline a:hover {
        color: var(--color-jade-deep);
        text-decoration: underline;
    }

    .services-premium-formulary__lists {
        display: grid;
        gap: var(--space-grid);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        list-style: none;
        margin-bottom: clamp(2rem, calc(1.58rem + 2.08vw), 3.25rem);
        padding: 0;
    }

    .services-premium-formulary__meta {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .services-premium-formulary__note {
        color: var(--color-sage);
        font-size: 0.875rem;
        margin-bottom: 0;
    }

    .services-premium-formulary__panel {
        background: var(--color-white);
        border: 0.0625rem solid var(--color-shell);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-card);
        height: 100%;
        padding: var(--pad-panel);
    }

    .services-premium-formulary__panel h3 {
        margin-bottom: 0.375rem;
    }

    .services-premium-formulary__unit {
        font-size: 0.4em;
        letter-spacing: 0.06em;
    }

    @media (max-width: 768px) {
        .services-premium-formulary__lists {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
