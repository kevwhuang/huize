---
import SectionHead from '@components/SectionHead.astro';
import { BASE_THEMES } from '@lib/constants';

const TRACKS = [
    {
        english: 'Wellness Retreat',
        link: '/network/bases',
        linkLabel: '查看康养基地',
        number: '01',
        tags: [...BASE_THEMES],
        text: '针对健康人群和活力老人，我们提供康养疗愈服务，在惠泽的康养基地进行身、心、灵的整体疗愈体验。惠泽布局了20多个各具特色的康养疗愈基地，为客户提供不同主题的疗愈选择。',
        title: '康养疗愈',
    },
    {
        english: 'Elderly Care',
        link: '/network/elderly-care',
        linkLabel: '查看养老网络',
        number: '02',
        tags: ['日间照料', '活力养老', '失能失智', '重度护理'],
        text: '针对需要到养老院或护理院的人群，惠泽从40000多家机构里甄选出2000家服务质量优、市场口碑好、软硬件配套完整的机构，遍布国内500个城市，为客户提供家门口的养老服务。',
        title: '甄选机构养老',
    },
];
---

<section
    class="services-wellness-offer section section--tint"
    aria-labelledby="services-wellness-offer-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Two Tracks"
            headingId="services-wellness-offer-title"
            isCentered
        >
            两条服务线，覆盖不同阶段的养老需求
            <Fragment slot="text">
                <p>从活力老人的身心灵疗愈，到失能失智人群的重度护理，惠泽提供分层分级的照护方案。</p>
            </Fragment>
        </SectionHead>

        <ul class="services-wellness-offer__tracks">
            {TRACKS.map((track, index) => (
                <li data-scroll={index === 0 ? 'left' : 'right'}>
                    <article class:list={['services-wellness-offer__panel', { 'services-wellness-offer__panel--dark': index === 1 }]}>
                        <p class="services-wellness-offer__meta">
                            <span class="numeral">{track.number}</span>
                            <span
                                class="label label--gold"
                                lang="en"
                            >
                                {track.english}
                            </span>
                        </p>
                        <h3>{track.title}</h3>
                        <p class="services-wellness-offer__text">{track.text}</p>
                        <ul class="services-wellness-offer__tags">
                            {track.tags.map(tag => (
                                <li class:list={['tag', { 'tag--on-dark': index === 1 }]}>{tag}</li>
                            ))}
                        </ul>
                        <a
                            class="link-more"
                            href={track.link}
                        >
                            {track.linkLabel}
                        </a>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .services-wellness-offer__meta {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.875rem;
    }

    .services-wellness-offer__panel {
        background: #FFFFFF;
        border: 0.0625rem solid var(--color-shell);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-card);
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: clamp(1.625rem, calc(1.29rem + 1.67vw), 2.625rem);
    }

    .services-wellness-offer__panel--dark {
        background: var(--color-pine);
        border-color: var(--color-pine);
        box-shadow: var(--shadow-panel);
    }

    .services-wellness-offer__panel--dark h3 {
        color: #FFFFFF;
    }

    .services-wellness-offer__panel--dark .label {
        color: var(--color-gold-light);
    }

    .services-wellness-offer__panel--dark .link-more {
        color: var(--color-reef);
    }

    .services-wellness-offer__panel--dark .numeral {
        color: var(--color-white-70);
    }

    .services-wellness-offer__panel--dark .services-wellness-offer__text {
        color: var(--color-white-70);
    }

    .services-wellness-offer__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin-bottom: 1.375rem;
        margin-top: auto;
        padding: 0;
    }

    .services-wellness-offer__text {
        color: var(--color-sage);
        font-size: 0.97rem;
        line-height: 1.95;
        margin-bottom: 1.5rem;
    }

    .services-wellness-offer__tracks {
        display: grid;
        gap: clamp(1.5rem, calc(1.17rem + 1.67vw), 2.5rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        list-style: none;
        padding: 0;
    }

    @media (max-width: 1024px) {
        .services-wellness-offer__tracks {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
