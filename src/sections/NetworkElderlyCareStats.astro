---
import IconCheck from '@components/IconCheck.astro';
import SectionHead from '@components/SectionHead.astro';
import { INSTITUTION_PROVINCES, TOTAL_INSTITUTIONS } from '@lib/constants';

const CANDIDATE_POOL = 40_000;
const PERCENT_SCALE = 100;

const CRITERIA = ['服务质量优', '市场口碑好', '软硬件配套完整'];

const STAGES = [
    { label: '全国康养机构', share: PERCENT_SCALE, suffix: '+', value: CANDIDATE_POOL },
    { label: '惠泽甄选机构', share: Math.round((TOTAL_INSTITUTIONS / CANDIDATE_POOL) * PERCENT_SCALE), suffix: '', value: TOTAL_INSTITUTIONS },
];
---

<section
    class="elderly-stats section section--tint"
    aria-labelledby="elderly-stats-title"
>
    <div class="shell elderly-stats__grid">
        <div data-scroll="left">
            <SectionHead
                eyebrow="Screened Network"
                headingId="elderly-stats-title"
            >
                从40000多家机构中<br />甄选2000家
                <Fragment slot="text">
                    <p>
                        惠泽从40000多家机构里甄选出2000家服务质量优、市场口碑好、软硬件配套完整的机构，遍布国内500个城市，为客户提供家门口的养老服务。
                    </p>
                </Fragment>
            </SectionHead>
            <ul class="elderly-stats__criteria">
                {CRITERIA.map(criterion => (
                    <li>
                        <span
                            class="check elderly-stats__check"
                            aria-hidden="true"
                        >
                            <IconCheck size={11} strokeWidth={3} />
                        </span>
                        {criterion}
                    </li>
                ))}
            </ul>
        </div>

        <ol
            class="elderly-stats__funnel"
            data-scroll="right"
        >
            {STAGES.map(stage => (
                <li class="elderly-stats__stage">
                    <p class="elderly-stats__stage-label">{stage.label}</p>
                    <p
                        class="elderly-stats__stage-value"
                        data-count-to={stage.value}
                        data-suffix={stage.suffix}
                    >
                        {stage.value}{stage.suffix}
                    </p>
                    <div
                        class="elderly-stats__bar"
                        aria-hidden="true"
                        style={`--share:${stage.share}%`}
                    />
                </li>
            ))}
            <li class="elderly-stats__stage">
                <p class="elderly-stats__stage-label">覆盖省份</p>
                <p
                    class="elderly-stats__stage-value"
                    data-count-to={INSTITUTION_PROVINCES.length}
                >
                    {INSTITUTION_PROVINCES.length}
                </p>
                <p class="elderly-stats__stage-note">
                    机构分布于全国 {INSTITUTION_PROVINCES.length} 个省级行政区，覆盖500多个城市。
                </p>
            </li>
        </ol>
    </div>
</section>

<style>
    .elderly-stats__bar {
        background: var(--color-shell);
        border-radius: var(--radius-pill);
        height: 0.375rem;
        margin-top: 0.875rem;
        overflow: clip;
        position: relative;
    }

    .elderly-stats__bar::after {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--share);
    }

    .elderly-stats__check {
        margin-top: 0.125rem;
    }

    .elderly-stats__criteria {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        padding: 0;
    }

    .elderly-stats__criteria li {
        align-items: start;
        color: var(--color-sage-dark);
        display: flex;
        gap: 0.6875rem;
        line-height: 1.6;
    }

    .elderly-stats__funnel {
        background: #FFFFFF;
        border: var(--border-soft);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-lift);
        display: grid;
        gap: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
        list-style: none;
        padding: clamp(1.75rem, calc(1.44rem + 1.56vw), 2.5rem);
    }

    .elderly-stats__grid {
        align-items: center;
        display: grid;
        gap: clamp(2.5rem, calc(1.67rem + 4.17vw), 4.5rem);
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .elderly-stats__stage + .elderly-stats__stage {
        border-top: 0.0625rem solid var(--color-snow);
        padding-top: clamp(1.5rem, calc(1.33rem + 0.83vw), 2rem);
    }

    .elderly-stats__stage-label {
        color: var(--color-sage);
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        margin-bottom: 0.375rem;
    }

    .elderly-stats__stage-note {
        color: var(--color-sage);
        font-size: 0.875rem;
        line-height: 1.8;
        margin-bottom: 0;
        margin-top: 0.5rem;
    }

    .elderly-stats__stage-value {
        color: var(--color-jade);
        font-family: var(--font-display);
        font-size: clamp(2rem, calc(1.67rem + 1.67vw), 3rem);
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0;
    }

    @media (max-width: 1024px) {
        .elderly-stats__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
