---
import SectionHead from '@components/SectionHead.astro';
import { SERVICES } from '@lib/constants';
---

<section
    class="services-index section"
    aria-labelledby="services-index-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Service System"
            headingId="services-index-title"
        >
            四大服务板块，<br />贯通康养与医疗全链路
            <Fragment slot="text">
                <p>惠泽提供全流程、一站式的养老服务和健康管理服务，链接保险客户、企业客户、个人客户与康养机构、医疗机构、服务机构，打通上下游供需。</p>
            </Fragment>
        </SectionHead>

        <ul
            class="services-index__list"
            data-scroll="scale"
            data-scroll-stagger="0.12"
        >
            {SERVICES.map(service => (
                <li>
                    <a
                        class="card card--flush card--hover services-index__card"
                        href={service.path}
                    >
                        <span
                            class="services-index__photo"
                            aria-hidden="true"
                            style={`background-image:url('${service.image}')`}
                        />
                        <div class="services-index__body">
                            <p class="services-index__meta">
                                <span class="numeral">{service.number}</span>
                                <span
                                    class="label label--gold"
                                    lang="en"
                                >
                                    {service.english}
                                </span>
                            </p>
                            <h3>{service.label}</h3>
                            <p class="services-index__headline">{service.headline}</p>
                            <p class="services-index__summary">{service.summary}</p>
                            <span class="link-more services-index__link">查看详情</span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .services-index__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: clamp(1.375rem, calc(1.21rem + 0.83vw), 1.875rem);
    }

    .services-index__body h3 {
        margin-bottom: 0.5rem;
    }

    .services-index__card {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .services-index__card:hover .link-more {
        gap: 0.875rem;
    }

    .services-index__headline {
        color: var(--color-pine-light);
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        margin-bottom: 0.625rem;
    }

    .services-index__link {
        margin-top: auto;
        padding-top: 1.25rem;
    }

    .services-index__list {
        display: grid;
        gap: clamp(1.5rem, calc(1.17rem + 1.67vw), 2.5rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        list-style: none;
        padding: 0;
    }

    .services-index__meta {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .services-index__photo {
        background-color: var(--color-jade-light);
        background-position: center;
        background-size: cover;
        display: block;
        height: clamp(9rem, calc(7.67rem + 6.67vw), 13rem);
    }

    .services-index__summary {
        color: var(--color-sage);
        font-size: 0.9rem;
        line-height: 1.85;
        margin-bottom: 0;
    }

    @media (max-width: 1024px) {
        .services-index__list {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
