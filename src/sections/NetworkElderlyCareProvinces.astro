---
import SectionHead from '@components/SectionHead.astro';
import { INSTITUTION_PROVINCES } from '@lib/constants';

const PERCENT_SCALE = 100;

const [largest] = INSTITUTION_PROVINCES;
---

<section
    class="provinces section"
    aria-labelledby="provinces-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Provincial Coverage"
            headingId="provinces-title"
        >
            {INSTITUTION_PROVINCES.length} 个省份的机构分布
            <Fragment slot="text">
                <p>按省级行政区统计的甄选机构数量与覆盖城市数量，广东、江苏、北京位居前三。</p>
            </Fragment>
        </SectionHead>

        <ol
            class="provinces__list"
            data-scroll="up"
            data-scroll-stagger="0.06"
        >
            {INSTITUTION_PROVINCES.map(province => (
                <li class="card provinces__item">
                    <h3 class="provinces__name">{province.name}</h3>
                    <p class="provinces__count">{province.institutions} 家</p>
                    <p class="provinces__cities">
                        {province.cities} 座城市 &middot; 覆盖示例：{province.sample.join('、')}
                    </p>
                    <div
                        class="provinces__bar"
                        aria-hidden="true"
                        style={`--share:${Math.round((province.institutions / largest.institutions) * PERCENT_SCALE)}%`}
                    />
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .provinces__bar {
        background: var(--color-mint);
        border-radius: var(--radius-pill);
        grid-column: 1 / -1;
        height: 0.25rem;
        overflow: clip;
        position: relative;
    }

    .provinces__bar::after {
        background: var(--color-jade);
        border-radius: var(--radius-pill);
        content: '';
        inset: 0 auto 0 0;
        position: absolute;
        width: var(--share);
    }

    .provinces__cities {
        color: var(--color-sage);
        font-size: 0.8125rem;
        grid-column: 1 / -1;
        line-height: 1.75;
        margin-bottom: 0;
        overflow-wrap: anywhere;
    }

    .provinces__count {
        color: var(--color-jade);
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0;
        text-align: right;
        white-space: nowrap;
    }

    .provinces__item {
        align-items: baseline;
        column-gap: 1rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 1.25rem 1.375rem;
        row-gap: 0.625rem;
    }

    .provinces__item:hover {
        border-color: var(--color-laurel);
        box-shadow: var(--shadow-lift);
    }

    .provinces__list {
        display: grid;
        gap: 0.875rem;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        list-style: none;
        padding: 0;
    }

    .provinces__name {
        font-size: 1.0625rem;
        margin-bottom: 0;
    }
</style>
