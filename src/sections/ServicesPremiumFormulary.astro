---
import SectionHead from '@components/SectionHead.astro';
import { LINKS } from '@lib/constants';

const LISTS = [
    { count: '100', english: 'Domestic', note: '国内100种特药清单', number: '01', title: '国内特药清单', unit: '种' },
    { count: '60', english: 'Overseas', note: '海外60种特药清单', number: '02', title: '海外特药清单', unit: '种' },
];
---

<section
    class="services-premium-formulary section section--tint"
    aria-labelledby="services-premium-formulary-title"
>
    <div class="shell">
        <SectionHead
            eyebrow="Formulary"
            headingId="services-premium-formulary-title"
            isCentered
        >
            特药清单
            <Fragment slot="text">
                <p>惠泽整理了国内与海外两份特药清单，为有需要的家庭提供药品信息与对接服务。</p>
            </Fragment>
        </SectionHead>

        <ul class="services-premium-formulary__lists">
            {LISTS.map((list, index) => (
                <li data-scroll={index === 0 ? 'left' : 'right'}>
                    <article class="services-premium-formulary__panel">
                        <p class="services-premium-formulary__meta">
                            <span class="numeral">{list.number}</span>
                            <span
                                class="label label--gold"
                                lang="en"
                            >
                                {list.english}
                            </span>
                        </p>
                        <p class="services-premium-formulary__count">
                            {list.count}
                            <span class="services-premium-formulary__unit">{list.unit}</span>
                        </p>
                        <h3>{list.title}</h3>
                        <p class="services-premium-formulary__note">{list.note}</p>
                    </article>
                </li>
            ))}
        </ul>

        <p
            class="services-premium-formulary__hotline"
            data-scroll
        >
            清单明细与适用范围请致电全国服务热线
            <a href={LINKS.hotlineHref}>{LINKS.hotline}</a>
            咨询，专属顾问将为您提供一对一的全流程服务。
        </p>
    </div>
</section>

<style>
    .services-premium-formulary__count {
        color: var(--color-jade);
        font-family: var(--font-display);
        font-size: clamp(3rem, calc(2.17rem + 4.17vw), 5.5rem);
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0.75rem;
    }

    .services-premium-formulary__hotline {
        color: var(--color-sage);
        margin-bottom: 0;
        margin-inline: auto;
        max-width: var(--measure-prose);
        text-align: center;
    }

    .services-premium-formulary__hotline a {
        color: var(--color-jade);
        font-weight: 500;
        transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
        white-space: nowrap;
    }

    .services-premium-formulary__hotline a:active {
        opacity: 0.8;
    }

    .services-premium-formulary__hotline a:hover {
        color: var(--color-jade-deep);
        text-decoration: underline;
    }

    .services-premium-formulary__lists {
        display: grid;
        gap: clamp(1.5rem, calc(1.17rem + 1.67vw), 2.5rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        list-style: none;
        margin-bottom: clamp(2rem, calc(1.58rem + 2.08vw), 3.25rem);
        padding: 0;
    }

    .services-premium-formulary__meta {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .services-premium-formulary__note {
        color: var(--color-sage);
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .services-premium-formulary__panel {
        background: #FFFFFF;
        border: 0.0625rem solid var(--color-shell);
        border-radius: var(--radius-card-lg);
        box-shadow: var(--shadow-card);
        height: 100%;
        padding: clamp(1.625rem, calc(1.29rem + 1.67vw), 2.625rem);
    }

    .services-premium-formulary__panel h3 {
        margin-bottom: 0.375rem;
    }

    .services-premium-formulary__unit {
        font-size: 0.4em;
        letter-spacing: 0.06em;
        margin-inline-start: 0.25em;
    }

    @media (max-width: 1024px) {
        .services-premium-formulary__lists {
            grid-template-columns: minmax(0, 1fr);
        }
    }

</style>
