---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import SubsidiariesBrands from '@sections/about/SubsidiariesBrands.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('about-subsidiaries');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <SubsidiariesBrands />
    <CtaBanner />
</Layout>
