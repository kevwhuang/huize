---
import Clients from '@sections/about/Clients.astro';
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Investors from '@sections/about/Investors.astro';
import Layout from '@/Layout.astro';
import Milestones from '@sections/about/Milestones.astro';
import PageHero from '@sections/shared/PageHero.astro';
import Story from '@sections/about/Story.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('about');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <Story />
    <Milestones />
    <Clients />
    <Investors />
    <CtaBanner />
</Layout>
