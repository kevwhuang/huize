---
import About from '@sections/home/About.astro';
import ContactPanel from '@sections/shared/ContactPanel.astro';
import Hero from '@sections/home/Hero.astro';
import Layout from '@/Layout.astro';
import Network from '@sections/home/Network.astro';
import News from '@sections/home/News.astro';
import Services from '@sections/home/Services.astro';
import { getPage, getSection } from '@lib/database';

const { description, title } = await getPage('home');
const homeHero = await getSection('home-hero');
---

<Layout
    description={description}
    preloadImage={homeHero.groups?.slides?.[0]?.image}
    title={title}
>
    <Hero />
    <About />
    <Services />
    <News />
    <Network />
    <ContactPanel />
</Layout>
