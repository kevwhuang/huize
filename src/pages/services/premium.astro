---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import PremiumFormulary from '@sections/services/PremiumFormulary.astro';
import PremiumIntro from '@sections/services/PremiumIntro.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('services-premium');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <PremiumIntro />
    <PremiumFormulary />
    <CtaBanner />
</Layout>
