---
import IndexGrid from '@sections/services/IndexGrid.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('services');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <IndexGrid />
</Layout>
