---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import InsuranceClients from '@sections/services/InsuranceClients.astro';
import InsuranceValue from '@sections/services/InsuranceValue.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('services-insurance');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <InsuranceValue />
    <InsuranceClients />
    <CtaBanner />
</Layout>
