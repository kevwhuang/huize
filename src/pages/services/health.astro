---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import HealthIntro from '@sections/services/HealthIntro.astro';
import HealthPrograms from '@sections/services/HealthPrograms.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('services-health');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <HealthIntro />
    <HealthPrograms />
    <CtaBanner />
</Layout>
