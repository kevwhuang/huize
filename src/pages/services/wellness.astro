---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import WellnessBases from '@sections/services/WellnessBases.astro';
import WellnessIntro from '@sections/services/WellnessIntro.astro';
import WellnessOffer from '@sections/services/WellnessOffer.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('services-wellness');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <WellnessIntro />
    <WellnessOffer />
    <WellnessBases />
    <CtaBanner />
</Layout>
