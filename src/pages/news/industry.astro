---
import IndustryList from '@sections/news/IndustryList.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('news-industry');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <IndustryList />
</Layout>
