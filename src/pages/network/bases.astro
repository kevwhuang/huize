---
import BasesGrid from '@sections/network/BasesGrid.astro';
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('network-bases');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <BasesGrid />
    <CtaBanner />
</Layout>
