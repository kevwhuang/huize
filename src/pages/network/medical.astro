---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import Layout from '@/Layout.astro';
import MedicalTiers from '@sections/network/MedicalTiers.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('network-medical');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <MedicalTiers />
    <CtaBanner />
</Layout>
