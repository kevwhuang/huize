---
import CtaBanner from '@sections/shared/CtaBanner.astro';
import ElderlyCareProvinces from '@sections/network/ElderlyCareProvinces.astro';
import ElderlyCareStats from '@sections/network/ElderlyCareStats.astro';
import Layout from '@/Layout.astro';
import PageHero from '@sections/shared/PageHero.astro';
import { getPage } from '@lib/database';

const { description, eyebrow = '', heading = '', title } = await getPage('network-elderly-care');
---

<Layout
    description={description}
    title={title}
>
    <PageHero eyebrow={eyebrow} title={heading} />
    <ElderlyCareStats />
    <ElderlyCareProvinces />
    <CtaBanner />
</Layout>
