---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

import '@/global.css';
import '@/styles.css';
import Footer from '@sections/shared/Footer.astro';
import Navbar from '@sections/shared/Navbar.astro';
import { BRAND, ROUTES } from '@lib/constants';

interface Props {
    description: string;
    noindex?: boolean;
    preloadImage?: string;
    title: string;
}

const EditorControls = import.meta.env.DEV ? (await import('@sections/shared/EditorControls.astro')).default : null;
const canonicalUrl = new URL(Astro.routePattern, Astro.site);

const currentRoute = ROUTES
    .flatMap(route => [...(route.children ?? []), route])
    .find(route => route.path === Astro.routePattern);

const { description, noindex, preloadImage, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;
const parentRoute = ROUTES.find(route => route.children?.some(child => child.path === Astro.routePattern));

const ancestorRoutes = parentRoute && parentRoute.path !== currentRoute?.path ? [parentRoute] : [];

const breadcrumbRoutes = currentRoute && currentRoute !== ROUTES[0] ? [ROUTES[0], ...ancestorRoutes, currentRoute] : [];

const breadcrumbList = {
    '@type': 'BreadcrumbList',
    'itemListElement': breadcrumbRoutes.map((route, index) => ({
        '@type': 'ListItem',
        'item': new URL(route.path, Astro.site).href,
        'name': route.label,
        'position': index + 1,
    })),
};

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        ...(breadcrumbRoutes.length > 0 ? [breadcrumbList] : []),
        {
            '@type': 'ItemList',
            'itemListElement': ROUTES.map((route, index) => ({
                '@type': 'SiteNavigationElement',
                'name': route.label,
                'position': index + 1,
                'url': new URL(route.path, Astro.site).href,
            })),
        },
        {
            '@type': 'WebSite',
            'author': {
                '@type': 'Person',
                'name': 'Wayne Huang',
            },
            'inLanguage': 'zh-CN',
            'name': BRAND.zh,
            'url': Astro.site,
        },
    ],
};
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        {preloadImage && (
            <link
                as="image"
                fetchpriority="high"
                href={preloadImage}
                rel="preload"
            />
        )}
        <title>{title}</title>
        <meta content="Wayne Huang" name="author" />
        <meta content={description} name="description" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <meta content="#0a3a33" name="theme-color" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/favicon.ico" rel="icon" type="image/x-icon" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={BRAND.zh} property="og:image:alt" />
        <meta content="630" property="og:image:height" />
        <meta content="1200" property="og:image:width" />
        <meta content="zh_CN" property="og:locale" />
        <meta content={BRAND.zh} property="og:site_name" />
        <meta content={title} property="og:title" />
        <meta content="website" property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <meta content={BRAND.zh} name="twitter:image:alt" />
        <meta content={title} name="twitter:title" />
        <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />
        <Font cssVariable="--font-jost" preload />
        <Font cssVariable="--font-noto-sans-sc" />
        <Font cssVariable="--font-noto-serif-sc" />
        <ClientRouter />
    </head>
    <body class="flex flex-col overflow-x-clip min-h-svh antialiased bg-cloud text-slate">
        <Navbar />
        <main class="flex flex-1 flex-col">
            <slot />
        </main>
        <Footer />
        {EditorControls && <EditorControls />}
    </body>
</html>

<script>
    import { initMotion } from '@lib/motion';

    document.addEventListener('astro:page-load', initMotion);
</script>
